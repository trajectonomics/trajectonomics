{
	"name": "@trajectonomics/web",
	"version": "0.0.0-development",
	"description": "The Dashboard: a static web app that renders a Snapshot of traj --json results on 127.0.0.1, and sends Edits through traj. Never published to npm. Only its hosted Demo build is served, as static pages on the Site.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trajectonomics/trajectonomics.git",
		"directory": "apps/web"
	},
	"type": "module",
	"private": true,
	"exports": {
		"./serve": "./scripts/serve.ts"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"build": "vite build && bun scripts/pack.ts",
		"build:hosted": "TRAJ_WEB_TARGET=hosted vite build",
		"typecheck": "svelte-kit sync && tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "bun test --parallel=2 --no-isolate ./src ./scripts",
		"test:src": "bun test ./src",
		"test:scripts": "bun test --parallel=2 --no-isolate ./scripts",
		"test:browser": "playwright test",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun scripts/demo-unless-turbo.ts && bun run test && bun ../../tooling/scripts/build-unless-turbo.ts",
		"snapshot": "bun scripts/snapshot.ts",
		"demo": "bun scripts/demo.ts",
		"dashboard": "bun scripts/dashboard.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@trajectonomics/brand": "workspace:*",
		"zod": "^4.6.7"
	}
}
