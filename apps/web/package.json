{
	"name": "@trajectonomics/web",
	"version": "0.0.0-development",
	"description": "The Dashboard: a read-only static web app that renders a Snapshot of traj --json results on 127.0.0.1. Never published to npm, never hosted.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trajectonomics/trajectonomics.git",
		"directory": "apps/web"
	},
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"build": "astro build",
		"typecheck": "tsc -p tsconfig.json && astro check",
		"test": "bun test ./src ./scripts",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun run test && bun run build",
		"snapshot": "bun scripts/snapshot.ts",
		"demo": "bun scripts/demo.ts",
		"dashboard": "bun scripts/dashboard.ts"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "2.6.3",
		"@tailwindcss/vite": "^4.3.5",
		"@trajectonomics/cli": "workspace:*",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"@astrojs/react": "^7.1.4",
		"@trajectonomics/brand": "workspace:*",
		"astro": "7.4.12",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	}
}
