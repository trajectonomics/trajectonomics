{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build", "@trajectonomics/brand#check"],
			"outputs": ["dist/**", "pack/**"]
		},
		"test": {
			"dependsOn": ["^build", "@trajectonomics/cli#build"]
		},
		"test:src": {
			"dependsOn": ["^build"]
		},
		"test:scripts": {
			"dependsOn": ["^build", "@trajectonomics/cli#build"],
			"cache": false
		},
		"check": {
			"dependsOn": ["build", "^build", "^check", "@trajectonomics/cli#build"]
		}
	}
}
