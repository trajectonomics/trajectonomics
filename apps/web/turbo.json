{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build", "@trajectonomics/brand#check"],
			"outputs": ["dist/**", "pack/**"]
		},
		"test": {
			"dependsOn": ["^build", "@trajectonomics/cli#build"]
		},
		"check": {
			"dependsOn": ["^build", "^check", "@trajectonomics/cli#build"]
		}
	}
}
