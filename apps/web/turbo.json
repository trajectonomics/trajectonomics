{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"demo": {
			"dependsOn": ["@trajectonomics/core#build"],
			"inputs": [
				"package.json",
				"scripts/demo*.ts",
				"scripts/demo/**",
				"scripts/run-*.ts",
				"scripts/snapshot-run.ts",
				"scripts/spawn.ts",
				"scripts/traj-binary.ts",
				"src/lib/contract/**",
				"src/lib/snapshot/**",
				"!**/*.test.ts",
				"!**/*.test-support.ts",
				"../cli/src/**",
				"!../cli/src/**/*.test.ts",
				"../cli/package.json"
			],
			"outputs": ["public/demo/snapshot.json"]
		},
		"build": {
			"dependsOn": ["^build", "@trajectonomics/brand#check", "demo"],
			"env": ["$TURBO_EXTENDS$", "TRAJ_WEB_VERSION"],
			"outputs": ["dist/**", "pack/**"]
		},
		"build:hosted": {
			"dependsOn": ["^build", "@trajectonomics/brand#check", "demo"],
			"env": ["TRAJ_WEB_VERSION"],
			"outputs": ["dist-hosted/**"]
		},
		"test": {
			"dependsOn": ["^build", "@trajectonomics/cli#build", "demo"]
		},
		"test:src": {
			"dependsOn": ["^build", "demo"]
		},
		"test:scripts": {
			"dependsOn": ["^build", "@trajectonomics/cli#build", "demo"],
			"cache": false
		},
		"check": {
			"dependsOn": ["build", "^build", "^check", "@trajectonomics/cli#build", "demo"]
		}
	}
}
