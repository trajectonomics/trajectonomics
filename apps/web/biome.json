{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": true,
	"extends": ["../../tooling/config/biome/base.json"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/*.md",
			"!**/skills-lock.json",
			"!**/.agents",
			"!**/.claude"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" }
				}
			}
		}
	]
}
