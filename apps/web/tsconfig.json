{
	"extends": ["$app/tsconfig", "./tsconfig.base.json"],
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["bun", "$app/types"],
		"isolatedDeclarations": false,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": false,
		"declaration": false
	},
	"include": [
		"src",
		"scripts",
		"browser",
		"vite.config.ts",
		"playwright.config.ts",
		".svelte-kit/ambient.d.ts"
	]
}
