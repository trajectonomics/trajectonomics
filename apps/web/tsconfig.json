{
	"extends": ["$app/tsconfig", "./tsconfig.base.json"],
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["bun", "$app/types"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"isolatedDeclarations": false,
		"resolveJsonModule": true,
		"declaration": false
	},
	"include": ["src", "scripts", "vite.config.ts", ".svelte-kit/ambient.d.ts"]
}
