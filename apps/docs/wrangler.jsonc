{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "docs",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	// One Worker only: a merge to `main` deploys production (ADR 0007), so there is no `env` block.
	// The Worker owns docs.trajectonomics.com. It does not attach the apex: the router still
	// forwards /docs there, and this Worker redirects those paths (ADR 0013).
	"routes": [{ "pattern": "docs.trajectonomics.com", "custom_domain": true }],
	"assets": {
		// astro.config.ts builds into ./dist, and request paths are the host root.
		"directory": "./dist",
		// The Worker redirects the old /docs mount and answers `Accept: text/markdown`
		// (ADR 0010, ADR 0013), then forwards everything else to the assets.
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
