---
import { ClientRouter } from "astro:transitions"
import appleTouchIcon from "@trajectonomics/brand/current/favicon/apple-touch-icon.png?url"
import faviconIco from "@trajectonomics/brand/current/favicon/favicon.ico?url"
import faviconSvg from "@trajectonomics/brand/current/favicon/favicon.svg?url"
import icon192 from "@trajectonomics/brand/current/favicon/icon-192.png?url"
import icon512 from "@trajectonomics/brand/current/favicon/icon-512.png?url"
import AgentLine from "../components/AgentLine.astro"
import {
	OG_TYPE,
	pageShare,
	SHARE_IMAGE_HEIGHT,
	SHARE_IMAGE_TYPE,
	SHARE_IMAGE_WIDTH,
	SITE_NAME,
	TWITTER_CARD,
} from "../lib/head-tags"
import "../styles/global.css"

interface Props {
	title: string
	description?: string | undefined
	/**
	 * The page's Markdown twin, for the head's alternate link and the Agent's pointer at the top of the
	 * body; a page with no twin passes none and carries neither.
	 */
	markdownTwin?: string | undefined
	/**
	 * The page's URL path on the Portal, which its canonical link and Open Graph and X card name as an
	 * absolute URL. A page with no path (the 404 page, which has no URL to name) carries none of them.
	 */
	path?: string | undefined
}

const { title, description, markdownTwin, path } = Astro.props
const share = path === undefined ? undefined : pageShare(path, title, description)
---

<!-- data-theme is the no-JS fallback; the theme provider (provider.tsx) forces the dark Theme and
     sets class and data-theme together before first paint, selecting the design-system Theme CSS. -->
<html lang="en" data-theme="dark" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{
			share && (
				<>
					<link rel="canonical" href={share.url} />
					<meta property="og:title" content={share.title} />
					<meta property="og:description" content={share.description} />
					<meta property="og:url" content={share.url} />
					<meta property="og:type" content={OG_TYPE} />
					<meta property="og:site_name" content={SITE_NAME} />
					<meta property="og:image" content={share.image} />
					<meta property="og:image:width" content={String(SHARE_IMAGE_WIDTH)} />
					<meta property="og:image:height" content={String(SHARE_IMAGE_HEIGHT)} />
					<meta property="og:image:type" content={SHARE_IMAGE_TYPE} />
					<meta name="twitter:card" content={TWITTER_CARD} />
					<meta name="twitter:image" content={share.image} />
				</>
			)
		}
		{markdownTwin && <link rel="alternate" type="text/markdown" href={markdownTwin} />}
		<link rel="icon" type="image/svg+xml" href={faviconSvg} />
		<link rel="icon" type="image/x-icon" sizes="any" href={faviconIco} />
		<link rel="icon" type="image/png" sizes="192x192" href={icon192} />
		<link rel="icon" type="image/png" sizes="512x512" href={icon512} />
		<link rel="apple-touch-icon" href={appleTouchIcon} />
		<ClientRouter />
		{/*
			One pageview per page the reader opens, posted from the page itself: the Portal loads no
			third-party script ([ADR 0008](./docs/adr/0008-analytics-from-the-page-itself.md)). The script
			decides for itself whether the host and the reader's opt-out signals allow it, and it measures
			the pages the Client Router swaps in as well as the first one.
		*/}
		<script>
			import { startAnalytics } from "../lib/analytics/client"

			startAnalytics()
		</script>
	</head>
	<body class="flex flex-col min-h-screen">
		{markdownTwin && <AgentLine twin={markdownTwin} />}
		<slot />
	</body>
</html>
