	"globalFlags": ["--json", "-h", "--help", "-v", "--version"],
	"commands": [
		{
			"name": "account",
			"summary": "Manage the chart of accounts"
		},
		{
			"name": "backup",
			"summary": "Write the one file a restore reads into a new directory"
		},
		{
			"name": "balance",
			"summary": "Show every account's balance and net worth at a date"
		},
		{
			"name": "baseline",
			"summary": "Show the Baseline a Projection starts from"
		},
		{
			"name": "dashboard",
			"summary": "Serve the Dashboard of this ledger on 127.0.0.1 until Ctrl-C"
		},
		{
			"name": "data",
			"summary": "Manage the stored data itself"
		},
		{
			"name": "doctor",
			"summary": "Check the data directory, the database and the ledger before anything goes wrong"
		},
		{
			"name": "export",
			"summary": "Write the stored rows into a new directory"
		},
		{
			"name": "fi",
			"summary": "Report the financial independence date under a Scenario"
		},
		{
			"name": "help",
			"summary": "Show usage for traj or for one command"
		},
		{
			"name": "init",
			"summary": "Create an empty ledger; only restore may also create one"
		},
		{
			"name": "inspect",
			"summary": "Show the stored rows of one table, or of every table"
		},
		{
			"name": "projection",
			"summary": "Project the future under a Scenario, and compare two of them"
		},
		{
			"name": "report",
			"summary": "Report on the ledger over a period or at a date"
		},
		{
			"name": "restore",
			"summary": "Write a backup's rows into an empty database"
		},
		{
			"name": "scenario",
			"summary": "Manage Scenarios, the named what-ifs"
		},
		{
			"name": "schema",
			"summary": "Describe the commands and the error registry"
		},
		{
			"name": "telemetry",
			"summary": "Show or change anonymous usage counting"
		},
		{
			"name": "tx",
			"summary": "Manage ledger transactions"
		},
		{
			"name": "version",
			"summary": "Print the CLI version"
		}
	],
	"exitCodes": [
		{
			"name": "0",
			"summary": "ok"
		},
		{
			"name": "1",
			"summary": "unexpected"
		},
		{
			"name": "2",
			"summary": "invalid input"
		},
		{
			"name": "3",
			"summary": "domain rejection"
		},
		{
			"name": "4",
			"summary": "not found"
		},
		{
			"name": "5",
			"summary": "conflict"
		}
	],
	"environment": [
		{
			"name": "TRAJ_FORMAT",
			"summary": "human (default) or json; --json takes precedence"
		},
		{
			"name": "TRAJ_HOME",
			"summary": "Data directory (default ~/.traj)"
