---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see these.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import Hero from "../../components/Hero.astro"
import TwoParts from "../../components/TwoParts.astro"
import Layout from "../../layouts/Layout.astro"
import type { Language } from "../../lib/language/language"
import { dictionaryFor } from "../../lib/language/languages"
import { languagePaths } from "../../lib/language/paths"

interface Props {
	readonly language: Language
}

export function getStaticPaths() {
	return languagePaths()
}

const { language } = Astro.props
const dictionary = dictionaryFor(language)
---

<Layout
	language={language}
	title={dictionary.documentTitle}
	description={dictionary.description}
	indexed={true}
>
	<Hero dictionary={dictionary} />
	<TwoParts dictionary={dictionary} />
</Layout>
