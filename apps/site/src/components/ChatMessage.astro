---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the icon it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import Bot from "./icons/Bot.astro"

interface Props {
	/** Who is speaking: the visitor's messages sit right, the agent's left. */
	readonly from: "you" | "agent"
	/** The speaker's label, read by a screen reader and never drawn: the side says it for the eye. */
	readonly speaker: string
	/** When this message's beat starts, in milliseconds from the panel's first beat. */
	readonly delayMs: number
}

const { from, speaker, delayMs } = Astro.props
---

<li class="chat-message" data-from={from} style={`--step-delay:${delayMs}ms`}>
	<span class="sr-only">{speaker}</span>
	<div class="chat-bubble">
		{
			from === "agent" ? (
				<>
					<Bot class="chat-mark" />
					<span class="chat-thinking dots" aria-hidden="true">
						<i /><i /><i />
					</span>
				</>
			) : null
		}
		<slot />
	</div>
</li>
