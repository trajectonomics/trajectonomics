---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the icons it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { GITHUB_ORG_URL } from "../lib/site"
import { STAR_MENU_ROWS, TOP_REPO_NAME } from "../lib/site/star-snapshot"
import { formatStarCount } from "../lib/site/stars"
import ArrowUpRight from "./icons/ArrowUpRight.astro"
import Chevron from "./icons/Chevron.astro"
import Star from "./icons/Star.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
const label =
	TOP_REPO_NAME === undefined
		? dictionary.starMenuLabel
		: `${dictionary.starMenuLabel}: ${TOP_REPO_NAME}`
---

<details class="header-menu" data-header-menu>
	<summary class="header-menu-summary" aria-label={label}>
		<Star class="header-menu-mark header-menu-star" />
		{TOP_REPO_NAME !== undefined && <span>{TOP_REPO_NAME}</span>}
		<Chevron class="header-menu-chevron" />
	</summary>
	<div
		class="header-menu-panel bg-popover text-popover-foreground"
		data-empty={STAR_MENU_ROWS.length === 0 ? "" : undefined}
	>
		{
			STAR_MENU_ROWS.length > 0 && (
				<p class="header-menu-group text-muted-foreground">{dictionary.starMenuGroupLabel}</p>
			)
		}
		{
			STAR_MENU_ROWS.length > 0 && (
				<ul class="header-menu-list">
					{STAR_MENU_ROWS.map((repo) => (
					<li>
						<a class="header-menu-row" href={repo.url}>
							<span class="header-menu-row-name">{repo.name}</span>
							{repo.stars !== undefined && (
								<span class="header-menu-row-count text-muted-foreground tabular-nums">
									{formatStarCount(repo.stars)}
								</span>
							)}
						</a>
						</li>
					))}
				</ul>
			)
		}
		<a class="header-menu-footer" href={GITHUB_ORG_URL}>
			<span>{dictionary.starMenuAllRepos}</span>
			<ArrowUpRight class="header-menu-out" />
		</a>
	</div>
</details>
