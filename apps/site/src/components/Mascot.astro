---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
/**
 * The Mascot: the blog covers' cream robot with the dark visor, the orange eyes and the orange-tipped antenna,
 * as a soft 3D render cut out of a green screen (ADR 0026). It is decoration, so its `alt` is empty and it says
 * nothing a reader needs. The poses, each a transparent WebP in `public/mascot/` at twice its largest size:
 * - `peek`: the head and two hands only, for the top edge of the hero's demo window.
 * - `chart`: standing, holding a card with rising bars, beside the Features heading.
 * - `wave`: standing, one arm up, above the closing call to action.
 * - `lost`: scratching its head under a question mark, on the Not-found page.
 * - `hello`: the head, one hand on the edge and one waving, in the demo's traj chat header (ADR 0027).
 * - `twins`: standing, holding up two checked cards, in the Agent-operated feature card.
 * - `think`: hand on chin under a lit bulb, beside the FAQ heading.
 * - `sit`: sitting on the hairline in the footer's link grid.
 */
interface Props {
	readonly pose: "peek" | "chart" | "wave" | "lost" | "hello" | "twins" | "think" | "sit"
	readonly class?: string
}

const { pose, class: className } = Astro.props
/** Each file's own size, so the box is reserved before it loads and nothing below it shifts. */
const SIZE = {
	peek: { width: 240, height: 161 },
	chart: { width: 176, height: 300 },
	wave: { width: 239, height: 340 },
	lost: { width: 221, height: 380 },
	hello: { width: 180, height: 120 },
	twins: { width: 181, height: 240 },
	think: { width: 134, height: 280 },
	sit: { width: 209, height: 240 },
}
// Only the hero's robot is in the first view; the rest wait until the visitor scrolls near them.
const eager = pose === "peek" || pose === "lost"
---

<img
	class:list={["mascot", className]}
	data-mascot={pose}
	src={`/mascot/${pose}.webp`}
	alt=""
	width={SIZE[pose].width}
	height={SIZE[pose].height}
	loading={eager ? "eager" : "lazy"}
	decoding="async"
	draggable="false"
/>
