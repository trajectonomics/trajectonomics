---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the links it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import {
	DIAGRAM_PLAN_AMOUNT,
	DIAGRAM_PLAN_COMMAND,
	DOCS_CLI_PATH,
	GITHUB_SKILLS_URL,
} from "../lib/site"
import Arrow from "./icons/Arrow.astro"
import Card from "./ui/Card.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
---

<section class="border-t border-border">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 sm:py-24">
		<h2 class="section-heading text-2xl text-balance text-foreground sm:text-3xl">
			{dictionary.twoPartHeading}
		</h2>
		<div class="diagram mt-10 sm:mt-14">
			<Card class="diagram-tile">
				<div class="diagram-bubbles" aria-hidden="true">
					<span class="diagram-bubble"></span>
					<span class="diagram-bubble diagram-bubble-back"></span>
				</div>
				<p class="diagram-title">{dictionary.agentCardTitle}</p>
				<p class="diagram-copy text-muted-foreground">{dictionary.agentCardCopy}</p>
			</Card>
			<div class="diagram-connector">
				<span class="diagram-connector-line" aria-hidden="true"></span>
				<span class="diagram-connector-label text-muted-foreground">{dictionary.diagramConnector}</span>
			</div>
			<Card class="diagram-tile">
				<div class="diagram-terminal">
					<code class="diagram-command">{DIAGRAM_PLAN_COMMAND}</code>
					<Arrow class="diagram-arrow" />
					<span class="diagram-amount tabular-nums">{DIAGRAM_PLAN_AMOUNT}</span>
				</div>
				<p class="diagram-title">{dictionary.cliCardTitle}</p>
				<p class="diagram-copy">{dictionary.cliCardCopy}</p>
			</Card>
		</div>
		<ul class="diagram-links">
			<li><a class="diagram-link" href={GITHUB_SKILLS_URL}>{dictionary.starOnboarding}</a></li>
			<li><a class="diagram-link" href={DOCS_CLI_PATH}>{dictionary.cliDocsLink}</a></li>
		</ul>
	</div>
</section>
