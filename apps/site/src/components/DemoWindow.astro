---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the icons and components it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import {
	COMPARE_ALONE,
	COMPARE_WITH,
	HINT_MS,
	sequenceTimeline,
	type Timeline,
	typing,
} from "../lib/motion/timeline"
import { DEMO_APP_NAME, DEMO_SKILL_COMMAND, FI_DEMO_COMMAND, FI_DEMO_OUTPUT } from "../lib/site"
import ChatMessage from "./ChatMessage.astro"
import Arrow from "./icons/Arrow.astro"
import Check from "./icons/Check.astro"
import Cross from "./icons/Cross.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
/** What the visitor types into the composer of each chat: the question alone, then the skill's command first. */
const question = dictionary.actionQuestion
const skilled = `${DEMO_SKILL_COMMAND} ${question}`
const typed = { without: typing([...question].length), with: typing([...skilled].length) }
// One beat per message, so the stylesheet plays the exchange and this file only says when each starts.
// Each chat's first message lands when its typed prompt is sent.
const alone = sequenceTimeline(COMPARE_ALONE, typed.without.sentMs)
const guided = sequenceTimeline(COMPARE_WITH, typed.with.sentMs)
/** The delay one beat starts at, in milliseconds, as the message renders it. */
const at = (sequence: Timeline, beat: number) => sequence.beats[beat]?.startMs ?? 0
/** The with chat's beats, in the order its markup renders them: five messages, the CLI, its lines, the answer. */
const BEAT = {
	question: 0,
	guide: 1,
	attach: 2,
	needMore: 3,
	data: 4,
	terminal: 5,
	lines: 6,
	answer: 6 + FI_DEMO_OUTPUT.length,
} as const
const guesses = dictionary.actionGuesses
/** The CSS custom properties that play one typed prompt: where it starts, how long, when it is sent. */
const keys = (prompt: typeof typed.with, chars: number) =>
	`--type-start:${prompt.startMs}ms;--type-ms:${prompt.typeMs}ms;--type-sent:${prompt.sentMs}ms;--chars:${chars}`
---

{/*
 * The demo window is the hero's picture of the app a visitor's agent runs in, in the way twenty.com's hero
 * carries its product. It holds two chats and shows one at a time: the agent alone, which answers badly, and
 * then a new chat with the traj skill, which asks, runs the CLI and reads the figure back. The Reveal layer
 * sets `data-stage` to say which chat is on screen and wires the sidebar's controls; with no script, or
 * with motion reduced, no stage is set and both chats stand whole, one above the other, and the sidebar
 * is out of the reading order. The buttons ship disabled for the same reason, so no control is offered
 * that cannot happen (ADR 0022).
 */}
<div class="app" data-app data-hint-ms={HINT_MS}>
	<div class="app-bar">
		<span class="app-dots" aria-hidden="true"><i /><i /><i /></span>
		<span class="app-title" aria-hidden="true">{DEMO_APP_NAME}</span>
		<button class="section-replay app-replay" type="button" data-app-replay hidden>
			{dictionary.replay}
		</button>
	</div>
	<div class="app-body">
		<div class="app-side" aria-hidden="true" data-app-side>
			<button class="app-new" type="button" data-app-new disabled>{dictionary.appNewChat}</button>
			<p class="app-side-label">{dictionary.appRecents}</p>
			<ul class="app-recents">
				<li>
					<button class="app-recent" type="button" data-app-chat="without" disabled>
						{dictionary.appTitleWithout}
					</button>
				</li>
				<li>
					<button class="app-recent" type="button" data-app-chat="with" disabled>
						{dictionary.appTitleWith}
					</button>
				</li>
			</ul>
		</div>

		<div class="app-main">
			<div class="app-chat" data-chat="without" data-play-ms={alone.totalMs}>
				<div class="app-chat-head">
					<span class="app-chat-title">{dictionary.appTitleWithout}</span>
					<span class="app-chat-tag" data-tone="bad">
						<Cross class="app-chat-mark" />{dictionary.actionWithoutLabel}
					</span>
				</div>
				<div class="app-scroll" role="region" aria-label={dictionary.appTitleWithout}>
					<ol class="chat">
						<ChatMessage from="you" speaker={dictionary.actionYou} delayMs={at(alone, 0)}>
							<p class="chat-text">{question}</p>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(alone, 1)}>
							<p class="chat-text">{guesses[0]}</p>
						</ChatMessage>
						<ChatMessage from="you" speaker={dictionary.actionYou} delayMs={at(alone, 2)}>
							<p class="chat-text">{dictionary.actionReask}</p>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(alone, 3)}>
							<p class="chat-text">{guesses[1]}</p>
						</ChatMessage>
						<ChatMessage from="you" speaker={dictionary.actionYou} delayMs={at(alone, 4)}>
							<p class="chat-text">{dictionary.actionExplain}</p>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(alone, 5)}>
							<p class="chat-text">{dictionary.actionGuessReason}</p>
						</ChatMessage>
						<ChatMessage from="you" speaker={dictionary.actionYou} delayMs={at(alone, 6)}>
							<p class="chat-text">{dictionary.actionSure}</p>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(alone, 7)}>
							<p class="chat-text">{dictionary.actionConfession}</p>
						</ChatMessage>
					</ol>
				</div>
				<p class="app-verdict text-muted-foreground" data-tone="bad" style={`--step-delay:${alone.totalMs}ms`}>
					{dictionary.actionWithoutNote}
				</p>
				<div class="app-composer" aria-hidden="true" style={keys(typed.without, [...question].length)}>
					<span class="app-field">
						<span class="app-placeholder">{dictionary.appPlaceholder}</span>
						<span class="app-typed">{question}</span>
					</span>
					<span class="app-send"><Arrow class="app-send-mark" /></span>
				</div>
			</div>

			<div class="app-chat" data-chat="with" data-play-ms={guided.totalMs}>
				<div class="app-chat-head">
					<span class="app-chat-title">{dictionary.appTitleWith}</span>
					<span class="app-chat-tag" data-tone="good">
						<Check class="app-chat-mark" />{dictionary.actionWithLabel}
					</span>
				</div>
				<div class="app-scroll" role="region" aria-label={dictionary.appTitleWith}>
					<ol class="chat">
						<ChatMessage from="you" speaker={dictionary.actionYou} delayMs={at(guided, BEAT.question)}>
							<p class="chat-text"><span class="app-chip">{DEMO_SKILL_COMMAND}</span> {question}</p>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(guided, BEAT.guide)}>
							<p class="chat-text">{dictionary.actionGuideQuestion}</p>
						</ChatMessage>
						<ChatMessage from="you" speaker={dictionary.actionYou} delayMs={at(guided, BEAT.attach)}>
							<p class="chat-text">{dictionary.actionAttach}</p>
							<span class="chat-file">{dictionary.actionAttachName}</span>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(guided, BEAT.needMore)}>
							<p class="chat-text">{dictionary.actionNeedMore}</p>
						</ChatMessage>
						<ChatMessage from="you" speaker={dictionary.actionYou} delayMs={at(guided, BEAT.data)}>
							<p class="chat-text">{dictionary.actionData}</p>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(guided, BEAT.terminal)}>
							<p class="chat-text chat-note">{dictionary.actionSkillLine}</p>
							<div class="terminal bg-stage text-stage-foreground">
								<code class="terminal-command"><span class="terminal-prompt" aria-hidden="true">$ </span>{FI_DEMO_COMMAND}</code>
								<pre class="terminal-output"><code>{FI_DEMO_OUTPUT.map((line, index) => <span class="terminal-line" style={`--step-delay:${at(guided, BEAT.lines + index)}ms`}>{line}</span>)}</code></pre>
								<p class="terminal-note">{dictionary.actionExampleNote}</p>
							</div>
						</ChatMessage>
						<ChatMessage from="agent" speaker={dictionary.actionAgent} delayMs={at(guided, BEAT.answer)}>
							<p class="chat-text">{dictionary.actionAnswer}</p>
							<p class="chat-provenance">{dictionary.actionProvenance}</p>
						</ChatMessage>
					</ol>
				</div>
				<p class="app-verdict text-foreground" data-tone="good" style={`--step-delay:${guided.totalMs}ms`}>
					{dictionary.actionWithNote}
				</p>
				<div class="app-composer" aria-hidden="true" style={keys(typed.with, [...skilled].length)}>
					<span class="app-field">
						<span class="app-placeholder">{dictionary.appPlaceholder}</span>
						<span class="app-typed"><span class="app-chip">{DEMO_SKILL_COMMAND}</span> {question}</span>
					</span>
					<span class="app-send"><Arrow class="app-send-mark" /></span>
				</div>
			</div>
		</div>
	</div>
</div>
