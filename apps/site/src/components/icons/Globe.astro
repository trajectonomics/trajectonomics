---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see the class it renders.
/** A globe, drawn with `currentColor`: the Language menu's mark, never a flag. */
interface Props {
	readonly class?: string
}

const { class: className } = Astro.props
---

<svg
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 16 16"
	width="16"
	height="16"
	class={className}
>
	<g fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
		<circle cx="8" cy="8" r="6"></circle>
		<path d="M2 8h12"></path>
		<ellipse cx="8" cy="8" rx="2.75" ry="6"></ellipse>
	</g>
</svg>
