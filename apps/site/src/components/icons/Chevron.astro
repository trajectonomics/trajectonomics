---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see the class it renders.
/** The chevron of a header disclosure, turned by the CSS that the menu is open. */
interface Props {
	readonly class?: string
}

const { class: className } = Astro.props
---

<svg
	class={className}
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 16 16"
	width="12"
	height="12"><path
		fill="none"
		stroke="currentColor"
		stroke-width="1.75"
		stroke-linecap="round"
		d="M4 6.5 8 10.5 12 6.5"></path></svg
>
