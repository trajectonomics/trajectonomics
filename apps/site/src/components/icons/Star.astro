---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see the class it renders.
/** A star, drawn with `currentColor`: the mark on the Star menu's trigger. */
interface Props {
	readonly class?: string
}

const { class: className } = Astro.props
---

<svg
	class={className}
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 16 16"
	width="12"
	height="12"><path
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linejoin="round"
	d="M8 1.8L9.6 5.8L13.9 6.1L10.6 8.8L11.6 13L8 10.7L4.4 13L5.4 8.8L2.1 6.1L6.4 5.8Z"></path></svg
>
