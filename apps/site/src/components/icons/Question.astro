---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see the class it renders.
/** A question mark: the setup questions the Onboarding skill asks, in the three-step strip. */
interface Props {
	readonly class?: string
}

const { class: className } = Astro.props
---

<svg
	class={className}
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 16 16"
	width="14"
	height="14"
>
	<path
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		d="M5.5 5.75a2.5 2.5 0 1 1 3.25 2.4c-.5.2-.75.6-.75 1.1v.5"></path>
	<circle cx="8" cy="12.25" r="1" fill="currentColor"></circle>
</svg>
