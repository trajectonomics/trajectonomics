---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see the icon it renders.
/** A bot's head, drawn with `currentColor`: the agent's mark in a chat and at the step it is running. */
interface Props {
	readonly class?: string
}

const { class: className } = Astro.props
---

<svg
	class={className}
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 16 16"
	width="12"
	height="12"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"><rect x="2.5" y="4.5" width="11" height="8" rx="2.5"></rect><path
		d="M8 1.5v3M5.75 8.25h.01M10.25 8.25h.01"></path></svg
>
