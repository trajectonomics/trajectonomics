---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see the class it renders.
/** A terminal window, drawn with `currentColor`: the first step of the strip under the command. */
interface Props {
	readonly class?: string
}

const { class: className } = Astro.props
---

<svg
	class={className}
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 16 16"
	width="14"
	height="14"
>
	<rect
		x="1"
		y="2.5"
		width="14"
		height="11"
		rx="2"
		fill="none"
		stroke="currentColor"
		stroke-width="1.25"></rect>
	<path
		fill="none"
		stroke="currentColor"
		stroke-width="1.25"
		stroke-linecap="round"
		stroke-linejoin="round"
		d="m4.5 6 2 2-2 2M9 10h2.5"></path>
</svg>
