---
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see the class it renders.
/** A hairline arrow: the direction the three steps under the command run in. */
interface Props {
	readonly class?: string
}

const { class: className } = Astro.props
---

<svg
	class={className}
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 24 12"
	width="24"
	height="12"><path
		fill="none"
		stroke="currentColor"
		stroke-width="1"
		stroke-linecap="round"
		stroke-linejoin="round"
		d="M1 6h20M17 2l4 4-4 4"></path></svg
>
