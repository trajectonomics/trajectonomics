---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the menus and the brand mark it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.

import LanguageMenu from "@trajectonomics/site-header/LanguageMenu.astro"
import SiteHeader from "@trajectonomics/site-header/SiteHeader.astro"
import type { Dictionary } from "../lib/language/dictionary"
import { currentLanguageName } from "../lib/language/dictionary"
import type { Language } from "../lib/language/language"
import {
	CLEAN_URL,
	languageChoiceLink,
	languageEntry,
	otherLanguages,
} from "../lib/language/languages"
import { BLOG_PATH, DATA_PATH, DOCS_PATH, OPENJOT_PATH, SITE_NAME } from "../lib/site"
import RepoLink from "./RepoLink.astro"

interface Props {
	readonly language: Language
	readonly dictionary: Dictionary
	/** A Language home is the page the reading Language points at; a miss is not. */
	readonly markCurrent: boolean
	/** The address a Language choice returns to: the page the visitor is reading. */
	readonly address: string
	/** Whether this is the OpenJot page, whose header link is then the current page. */
	readonly openjotCurrent: boolean
}

const { language, dictionary, markCurrent, address, openjotCurrent } = Astro.props
// The Site's sections live in the centre; the reading Language and the repository are its tools.
const choices = [languageEntry(language), ...otherLanguages(language)].map((entry) => ({
	href: languageChoiceLink(entry.language, address),
	lang: entry.language,
	label: entry.dictionary.languageName,
	current: entry.language === language && markCurrent,
	ariaLabel: entry.language === language ? currentLanguageName(dictionary) : undefined,
}))
---

<SiteHeader
	homeHref={CLEAN_URL}
	homeLabel={SITE_NAME}
	class="site-header fixed inset-x-0 top-0"
	navLabel="Main"
>
	<Fragment slot="nav">
		<a
			class="ds-nav-link"
			href={OPENJOT_PATH}
			aria-current={openjotCurrent ? "page" : undefined}
		>
			{dictionary.openjotLink}
		</a>
		<a class="ds-nav-link" href={DATA_PATH}>{dictionary.dataLink}</a>
		<a class="ds-nav-link" href={BLOG_PATH}>{dictionary.blogLink}</a>
		<a class="ds-nav-link" href={DOCS_PATH}>{dictionary.docsLink}</a>
	</Fragment>
	<Fragment slot="end">
		<RepoLink dictionary={dictionary} />
		<span class="header-sep" aria-hidden="true"></span>
		<LanguageMenu
			summaryLabel={dictionary.languageSwitchLabel}
			currentLabel={dictionary.languageSwitchLabel}
			choices={choices}
		/>
	</Fragment>
</SiteHeader>
