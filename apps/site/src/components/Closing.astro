---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the icon and the paths it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { DOCS_CLI_INSTALL_PATH } from "../lib/site"
import Arrow from "./icons/Arrow.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
---

{/*
 * The closing section: the demo's question put to the visitor's own agent, then the hero CTA's two
 * controls once more. The page keeps one Copy control and no visible prompt (ADR 0015, amendment of
 * 2026-11-19), so the filled link goes back up to it rather than copying a second time, and the outlined
 * one is the hero's own way out, with the same words to the same page.
 */}
<section class="section-surface" data-closing>
	<div class="section-inner closing">
		<p class="eyebrow">{dictionary.ctaEyebrow}</p>
		<h2 class="section-heading text-3xl text-balance text-foreground sm:text-4xl">
			{dictionary.ctaHeading}
		</h2>
		<p class="section-lede closing-lede text-foreground">{dictionary.ctaLede}</p>
		<div class="install-row closing-actions">
			<a
				class="closing-primary bg-primary text-primary-foreground"
				data-bevel
				data-closing-prompt
				href="#install"
			>
				{dictionary.ctaPromptLink}
			</a>
			<a class="window-exit" data-bevel href={DOCS_CLI_INSTALL_PATH}>
				{dictionary.cliInstallLink}<Arrow class="window-exit-arrow" />
			</a>
		</div>
	</div>
</section>
