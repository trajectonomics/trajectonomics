---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see <CopyCommand /> and the links it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { sublineParts } from "../lib/language/subline"
import { HERO_RELEASE_DATE } from "../lib/site"
import CopyCommand from "./CopyCommand.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
const subline = sublineParts(dictionary.heroSubline)
---

<section data-hero class="relative overflow-clip bg-muted">
	<div class="hero-glow" aria-hidden="true"></div>
	<div class="hero-pointer-glow" data-pointer-glow aria-hidden="true"></div>
	<div
		class="hero-rise mx-auto flex max-w-6xl flex-col items-center px-5 pt-32 pb-16 text-center sm:px-6 sm:pt-40 sm:pb-24"
	>
		<p class="hero-eyebrow text-foreground">
			<span>{dictionary.heroRelease}</span>
			<span class="hero-eyebrow-sep" aria-hidden="true">·</span>
			<time class="hero-release-date" datetime={HERO_RELEASE_DATE}>
				{dictionary.heroReleaseDate}
			</time>
		</p>
		<h1
			data-hero-headline
			class="mt-8 max-w-2xl text-4xl font-light tracking-tight text-balance text-foreground sm:text-6xl"
		>
			<span>{dictionary.heroHeadingPrefix}</span>
			<span data-hero-stack class="text-destructive">
				{dictionary.heroHeadingCycle.map((suffix) => <span>{suffix}</span>)}
			</span>
		</h1>
		<p class="mt-8 max-w-xl text-base text-pretty text-foreground sm:text-lg">
			{
				subline.map((part) =>
					part.code ? (
						<code class="rounded-md bg-secondary px-1.5 py-0.5 font-mono text-[0.9em] text-secondary-foreground">
							{part.text}
						</code>
					) : (
						<Fragment>{part.text}</Fragment>
					),
				)
			}
		</p>
		<div class="mt-10 w-full max-w-xl sm:mt-12">
			<CopyCommand dictionary={dictionary} />
		</div>
	</div>
</section>

<script is:inline>
	;(() => {
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches

		// The suffix cycle is decoration: a visitor who asks for less motion keeps the suffix the page ships.
		const stack = document.querySelector("[data-hero-stack]")
		if (stack instanceof HTMLElement && !reduced) {
			const lines = [...stack.children]
			/** Show one suffix, then the next 2.4 s later; the last one stays. */
			const show = (step) => {
				const line = lines[step]
				if (!(line instanceof HTMLElement)) return
				for (const other of lines) if (other !== line) other.removeAttribute("data-hero-shown")
				line.setAttribute("data-hero-shown", "")
				stack.setAttribute("data-hero-stepping", "")
				if (step + 1 < lines.length) setTimeout(() => show(step + 1), 2400)
			}
			show(0)
		}

		// The one JavaScript motion: a soft light that follows the pointer, transform only.
		const hero = document.querySelector("[data-hero]")
		const glow = document.querySelector("[data-pointer-glow]")
		if (
			hero instanceof HTMLElement &&
			glow instanceof HTMLElement &&
			!reduced &&
			window.matchMedia("(pointer: fine)").matches
		) {
			let tx = 0
			let ty = 0
			let cx = 0
			let cy = 0
			let raf = null
			const tick = () => {
				cx += (tx - cx) * 0.12
				cy += (ty - cy) * 0.12
				glow.style.transform = `translate3d(${cx - 240}px, ${cy - 240}px, 0)`
				if (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5) raf = requestAnimationFrame(tick)
				else raf = null
			}
			hero.addEventListener("pointermove", (event) => {
				const box = hero.getBoundingClientRect()
				tx = event.clientX - box.left
				ty = event.clientY - box.top
				glow.style.opacity = "1"
				if (raf === null) raf = requestAnimationFrame(tick)
			})
			hero.addEventListener("pointerleave", () => {
				glow.style.opacity = "0"
			})
		}
	})()
</script>

<style>
	/*
		The suffixes share one grid cell, so the hero is as tall as its longest suffix and the page
		never shifts; only the shown one is visible, and with no script that is the shipped suffix.
		The slot is its own line, so a suffix shorter than the longest one leaves no gap after the
		prefix, whatever the Language and width.
	*/
	[data-hero-stack] {
		display: grid;
		justify-items: center;
	}

	[data-hero-stack] > span {
		grid-area: 1 / 1;
		visibility: hidden;
	}

	[data-hero-stack]:not([data-hero-stepping]) > span:last-child,
	[data-hero-stack] > span[data-hero-shown] {
		visibility: visible;
	}

	[data-hero-stack][data-hero-stepping] > span {
		visibility: visible;
		opacity: 0;
		transform: translateY(0.35em);
		transition:
			opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	[data-hero-stack][data-hero-stepping] > span[data-hero-shown] {
		opacity: 1;
		transform: none;
	}
</style>
