---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see <CopyCommand /> and the badge it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { sublineParts } from "../lib/language/subline"
import CopyCommand from "./CopyCommand.astro"
import Badge from "./ui/Badge.astro"
import Separator from "./ui/Separator.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
const subline = sublineParts(dictionary.heroSubline)
---

<section data-hero class="relative overflow-clip">
	<div class="hero-pointer-glow" data-pointer-glow aria-hidden="true"></div>
	<div
		class="hero-rise mx-auto flex max-w-6xl flex-col items-center px-5 pt-32 pb-16 text-center sm:px-6 sm:pt-40 sm:pb-24"
	>
		<Badge class="hero-pill">
			<span class="hero-pill-marker" aria-hidden="true"></span>
			<span>{dictionary.heroVersion}</span>
			<Separator />
			<span>{dictionary.heroLicence}</span>
		</Badge>
		<h1
			data-hero-headline
			class="mt-8 max-w-2xl text-4xl font-light text-balance text-foreground sm:text-6xl"
		>
			<span>{dictionary.heroHeadingPrefix}</span>
			<span data-hero-stack class="text-accent">
				{dictionary.heroHeadingCycle.map((suffix) => <span>{suffix}</span>)}
			</span>
		</h1>
		<p class="mt-8 max-w-xl text-base text-pretty text-muted-foreground sm:text-lg">
			{
				subline.map((part) =>
					part.code ? (
						<code class="rounded-sm bg-secondary px-1.5 py-0.5 font-mono text-[0.9em] text-secondary-foreground">
							{part.text}
						</code>
					) : (
						<Fragment>{part.text}</Fragment>
					),
				)
			}
		</p>
		<div class="hero-command mt-10 w-full max-w-xl sm:mt-12">
			<CopyCommand dictionary={dictionary} />
		</div>
	</div>
</section>

<script is:inline>
	;(() => {
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches

		// The suffix cycle is decoration: a visitor who asks for less motion keeps the suffix the page ships.
		const stack = document.querySelector("[data-hero-stack]")
		if (stack instanceof HTMLElement && !reduced) {
			const lines = [...stack.children]
			/** Show one suffix, then the next 2.4 s later; the last one stays. */
			const show = (step) => {
				const line = lines[step]
				if (!(line instanceof HTMLElement)) return
				for (const other of lines) if (other !== line) other.removeAttribute("data-hero-shown")
				line.setAttribute("data-hero-shown", "")
				stack.setAttribute("data-hero-stepping", "")
				if (step + 1 < lines.length) setTimeout(() => show(step + 1), 2400)
			}
			show(0)
		}

		// The one JavaScript motion: a soft light that follows the pointer, transform only.
		const hero = document.querySelector("[data-hero]")
		const glow = document.querySelector("[data-pointer-glow]")
		if (
			hero instanceof HTMLElement &&
			glow instanceof HTMLElement &&
			!reduced &&
			window.matchMedia("(pointer: fine)").matches
		) {
			let tx = 0
			let ty = 0
			let cx = 0
			let cy = 0
			let raf = null
			const tick = () => {
				cx += (tx - cx) * 0.12
				cy += (ty - cy) * 0.12
				glow.style.transform = `translate3d(${cx - 240}px, ${cy - 240}px, 0)`
				if (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5) raf = requestAnimationFrame(tick)
				else raf = null
			}
			hero.addEventListener("pointermove", (event) => {
				const box = hero.getBoundingClientRect()
				tx = event.clientX - box.left
				ty = event.clientY - box.top
				glow.style.opacity = "1"
				if (raf === null) raf = requestAnimationFrame(tick)
			})
			hero.addEventListener("pointerleave", () => {
				glow.style.opacity = "0"
			})
		}
	})()
</script>
