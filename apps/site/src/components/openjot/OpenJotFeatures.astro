---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the Mascot it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import type { OpenJotDictionary } from "../../lib/language/openjot-dictionary"
import Mascot from "../Mascot.astro"

interface Props {
	readonly dictionary: OpenJotDictionary
}

const { dictionary } = Astro.props
---

<section class="section-surface bg-background" aria-labelledby="openjot-features">
	<div class="section-inner">
		<div class="section-head-row">
			<div class="section-head">
				<p class="eyebrow">{dictionary.featuresEyebrow}</p>
				<h2 id="openjot-features" class="section-heading text-3xl text-balance text-foreground sm:text-4xl">
					{dictionary.featuresHeading}
				</h2>
			</div>
			<Mascot pose="chart" class="mascot-features" />
		</div>
		<ul class="features">
			{
				dictionary.featureTitles.map((title, index) => (
					<li class="feature bg-background text-foreground">
						<span class="feature-index text-muted-foreground tabular-nums">
							{String(index + 1).padStart(2, "0")}
						</span>
						<span class="feature-title">{title}</span>
						<span class="feature-copy text-muted-foreground">
							{dictionary.featureCopies[index]}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
