---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the fixture and the props it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { INSTALL_COMMAND } from "../lib/site"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
---

<div class="relative">
	<span class="hero-plus top-[-7px] left-[-7px]" aria-hidden="true"></span>
	<span class="hero-plus top-[-7px] right-[-7px]" aria-hidden="true"></span>
	<span class="hero-plus bottom-[-7px] left-[-7px]" aria-hidden="true"></span>
	<span class="hero-plus bottom-[-7px] right-[-7px]" aria-hidden="true"></span>
	<div
		class="overflow-hidden rounded-[20px] border border-border bg-background text-left shadow-2xl"
	>
		<div class="flex items-center gap-2 border-b border-border bg-secondary px-4 py-2.5">
			<span class="h-3 w-3 rounded-full bg-destructive" aria-hidden="true"></span>
			<span class="h-3 w-3 rounded-full bg-border" aria-hidden="true"></span>
			<span class="h-3 w-3 rounded-full bg-border" aria-hidden="true"></span>
			<span class="ml-2 font-mono text-xs text-foreground">terminal</span>
		</div>
		<div class="flex flex-col items-stretch gap-3 p-4 sm:flex-row sm:items-center">
			<code
				data-install-command
				class="min-w-0 flex-1 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap text-foreground sm:text-base"
			>
				{INSTALL_COMMAND}
			</code>
			<button
				type="button"
				hidden
				data-copy-command
				data-copied={dictionary.copied}
				data-copy-failed={dictionary.copyFailed}
				class="shrink-0 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				{dictionary.copy}
			</button>
		</div>
		<p
			role="status"
			aria-live="polite"
			aria-atomic="true"
			data-copy-status
			class="min-h-4 px-4 pb-3 text-xs text-muted-foreground"
		>
		</p>
	</div>
</div>

<script is:inline>
	;(() => {
		const command = document.querySelector("[data-install-command]")
		const button = document.querySelector("[data-copy-command]")
		const status = document.querySelector("[data-copy-status]")
		if (
			!(command instanceof HTMLElement) ||
			!(button instanceof HTMLButtonElement) ||
			!(status instanceof HTMLElement)
		) {
			return
		}

		// The button is progressive enhancement: with JavaScript off the command alone is the action.
		button.hidden = false
		button.addEventListener("click", async () => {
			const text = command.textContent?.trim() ?? ""
			try {
				await navigator.clipboard.writeText(text)
				status.textContent = button.dataset.copied ?? ""
			} catch {
				const range = document.createRange()
				range.selectNodeContents(command)
				const selection = document.getSelection()
				selection?.removeAllRanges()
				selection?.addRange(range)
				status.textContent = button.dataset.copyFailed ?? ""
			}
		})
	})()
</script>
