---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the icons, the button and the props it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { DOCS_CLI_INSTALL_PATH, INSTALL_COMMAND } from "../lib/site"
import Arrow from "./icons/Arrow.astro"
import Check from "./icons/Check.astro"
import Question from "./icons/Question.astro"
import Terminal from "./icons/Terminal.astro"
import Button from "./ui/Button.astro"
import Card from "./ui/Card.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
// How long the copy toast stays before it clears itself, which is also how long its countdown runs.
const NOTICE_TIMEOUT_MS = 6000
/** The three steps under the command, each with the mark its label names. */
const STEPS = [Terminal, Question, Check] as const
---

<div class="relative">
	<Card variant="panel" class="overflow-hidden text-left">
		<div class="flex items-center gap-2 border-b border-border bg-secondary px-4 py-2.5">
			<span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
		</div>
		<div class="flex flex-col items-stretch gap-3 p-4 sm:flex-row sm:items-center">
			<code
				data-install-command
				class="min-w-0 flex-1 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap text-foreground sm:text-base"
			>
				{INSTALL_COMMAND}
			</code>
			<Button
				type="button"
				bevel
				hidden
				data-copy-command
				data-copied={dictionary.copied}
				data-copy-failed={dictionary.copyFailed}
				data-notice-timeout={NOTICE_TIMEOUT_MS}
				class="shrink-0 px-5"
			>
				{dictionary.copy}
			</Button>
		</div>
		<ol class="window-steps text-muted-foreground">
			{
				STEPS.map((Mark, step) => (
					<li class="window-step">
						{step > 0 ? <Arrow class="window-step-arrow" /> : null}
						<Mark class="window-step-mark" />
						<span>{dictionary.stepLabels[step]}</span>
					</li>
				))
			}
		</ol>
		<a class="window-exit" href={DOCS_CLI_INSTALL_PATH}>
			{dictionary.cliInstallLink}<Arrow class="window-exit-arrow" />
		</a>
	</Card>
	<div
		data-copy-toast
		class="copy-toast rounded-sm border border-border bg-popover text-popover-foreground"
		style={`--toast-ms: ${NOTICE_TIMEOUT_MS}ms`}
	>
		<Check class="copy-toast-check" data-copy-check />
		<span
			data-copy-status
			class="text-xs font-medium"
			role="status"
			aria-live="polite"
			aria-atomic="true"></span>
		<span class="copy-toast-countdown" aria-hidden="true"></span>
	</div>
</div>

<script is:inline>
	;(() => {
		const command = document.querySelector("[data-install-command]")
		const button = document.querySelector("[data-copy-command]")
		const status = document.querySelector("[data-copy-status]")
		const toast = document.querySelector("[data-copy-toast]")
		const check = document.querySelector("[data-copy-check]")
		if (
			!(command instanceof HTMLElement) ||
			!(button instanceof HTMLButtonElement) ||
			!(status instanceof HTMLElement) ||
			!(toast instanceof HTMLElement)
		) {
			return
		}

		const timeoutMs = Number(button.dataset.noticeTimeout ?? "6000")
		let notice = null
		/** The toast confirms the copy, then clears itself so the next step keeps the eye. */
		const notify = (message, failed) => {
			status.textContent = message
			if (check instanceof HTMLElement) check.hidden = failed
			// Re-attaching the state restarts the countdown, so a second copy gets its own six seconds.
			toast.removeAttribute("data-visible")
			void toast.offsetWidth
			toast.setAttribute("data-visible", "")
			if (notice !== null) clearTimeout(notice)
			notice = setTimeout(() => {
				status.textContent = ""
				toast.removeAttribute("data-visible")
				notice = null
			}, timeoutMs)
		}

		// The button is progressive enhancement: with JavaScript off the command alone is the action.
		button.hidden = false
		button.addEventListener("click", async () => {
			const text = command.textContent?.trim() ?? ""
			try {
				await navigator.clipboard.writeText(text)
				notify(button.dataset.copied ?? "", false)
				// The command reached the clipboard: say so once, so the page can count the copy. The
				// name is stable because the command text changes with every release.
				window.dispatchEvent(
					new CustomEvent("traj:site-command-copied", { detail: { command: "install" } }),
				)
			} catch {
				const range = document.createRange()
				range.selectNodeContents(command)
				const selection = document.getSelection()
				selection?.removeAllRanges()
				selection?.addRange(range)
				notify(button.dataset.copyFailed ?? "", true)
			}
		})
	})()
</script>
