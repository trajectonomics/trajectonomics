---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the icons it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { HOW_FLOW } from "../lib/motion/timeline"
import { DOCS_CLI_PATH, FI_DEMO_DATE, GITHUB_SKILLS_URL } from "../lib/site"
import Bot from "./icons/Bot.astro"
import Check from "./icons/Check.astro"
import LayerAgent from "./LayerAgent.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
/** The three outputs, named by the Dictionary and drawn under their own name. */
const name = (index: number) => dictionary.howPresentationItems[index] ?? ""
/** The chart's six bars, as a share of its height: a projection rising to the figure it reads. */
const BARS = Object.freeze([32, 44, 50, 62, 71, 86])
/** The year the figure lands in, read from the one demo fixture the page prints. */
const YEAR = FI_DEMO_DATE.slice(0, 4)
---

<section class="section-muted">
	<div class="section-inner">
		<div class="section-head-row">
			<div class="section-head">
				<p class="eyebrow">{dictionary.howEyebrow}</p>
				<h2 class="section-heading text-3xl text-balance text-foreground sm:text-4xl">
					{dictionary.howHeading}
				</h2>
				<p class="section-lede text-foreground">{dictionary.howLede}</p>
			</div>
			<button
				class="section-replay"
				type="button"
				data-replay
				aria-label={`${dictionary.replay} — ${dictionary.howHeading}`}
				hidden
			>
				{dictionary.replay}
			</button>
		</div>

		<div class="how" data-flow-ms={HOW_FLOW.beatMs} data-flow-steps={HOW_FLOW.beats}>
			<ol class="how-steps">
				{/* One token rides the list: it translates to the row that is running, and stops there. */}
				<span class="how-step-token" aria-hidden="true">
					<Bot class="how-step-token-mark" />
				</span>
				{
					dictionary.howSteps.map((step, index) => (
						<li class="how-step">
							<span class="how-step-number tabular-nums">
								{String(index + 1).padStart(2, "0")}
							</span>
							<span class="how-step-text">
								<span class="text-foreground">{step}</span>
								<span class="how-step-actor">
									<Bot class="how-step-mark" />
									{dictionary.howStepActors[index]}
								</span>
							</span>
							<span class="how-step-running dots" aria-hidden="true">
								<i /><i /><i />
							</span>
						</li>
					))
				}
			</ol>

			<div class="layers">
				<div class="layer layer-presentation bg-background text-foreground">
					<div class="layer-head">
						<span class="layer-name">{dictionary.howPresentationLabel}</span>
						<span class="layer-owner">{dictionary.howPresentationOwner}</span>
					</div>
					<p class="layer-copy text-foreground">{dictionary.howPresentationCopy}</p>
					<ul class="layer-chips">
						<li class="layer-output">
							<span class="layer-chip">{name(0)}</span>
							<span class="how-output how-output-answer">
								<span class="how-output-bubble">{dictionary.howOutputChat[0]}</span>
								<span class="how-output-bubble how-output-bubble-agent">
									{dictionary.howOutputChat[1]}
								</span>
							</span>
						</li>
						<li class="layer-output">
							<span class="layer-chip">{name(1)}</span>
							<span class="how-output how-output-chart">
								<span class="how-output-bars">
									{/* The value rides the last, accent bar: it is what that bar reads. */}
									{BARS.map((bar) => (
										<span class="how-output-bar" style={`--bar:${bar}%`}>
											{bar === BARS.at(-1) ? <span class="how-output-value">{YEAR}</span> : null}
										</span>
									))}
								</span>
							</span>
						</li>
						<li class="layer-output">
							<span class="layer-chip">{name(2)}</span>
							<span class="how-output how-output-action">
								<Check class="how-output-tick" />
								<span>{dictionary.howOutputStatus}</span>
								<span class="how-output-source">{dictionary.howOutputSource}</span>
							</span>
						</li>
					</ul>
					<LayerAgent step={1} actor={dictionary.howStepActors[0] ?? ""} />
					<LayerAgent step={4} actor={dictionary.howStepActors[3] ?? ""} />
					<span class="layers-pulse" aria-hidden="true" />
				</div>

				<div class="layers-growth">
					<div class="layers-growth-inner">
						<div class="layers-join">
							<span class="layers-join-line" aria-hidden="true"></span>
							<p class="layers-join-label">
								<span class="layers-join-name">{dictionary.howSkillsLabel}</span>
								<span class="text-muted-foreground">{dictionary.howSkillsCopy}</span>
								<LayerAgent step={2} actor={dictionary.howStepActors[1] ?? ""} />
							</p>
							<span class="layers-join-line" aria-hidden="true"></span>
						</div>

						<div class="layer layer-logic bg-stage text-stage-foreground">
							<div class="layer-head">
								<span class="layer-name">{dictionary.howLogicLabel}</span>
								<span class="layer-owner">{dictionary.howLogicOwner}</span>
							</div>
							<p class="layer-copy">{dictionary.howLogicCopy}</p>
							<ul class="layer-chips">
								{dictionary.howLogicItems.map((item) => <li class="layer-chip">{item}</li>)}
							</ul>
							<LayerAgent step={3} actor={dictionary.howStepActors[2] ?? ""} />
						</div>
					</div>
				</div>
			</div>
		</div>

		<ul class="section-links">
			<li><a class="section-link" href={GITHUB_SKILLS_URL}>{dictionary.starOnboarding}</a></li>
			<li><a class="section-link" href={DOCS_CLI_PATH}>{dictionary.cliDocsLink}</a></li>
		</ul>
	</div>
</section>
