---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the links it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { DOCS_CLI_PATH, GITHUB_SKILLS_URL } from "../lib/site"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
---

<section class="section-muted">
	<div class="section-inner">
		<div class="section-head">
			<p class="eyebrow">{dictionary.howEyebrow}</p>
			<h2 class="section-heading text-3xl text-balance text-foreground sm:text-4xl">
				{dictionary.howHeading}
			</h2>
			<p class="section-lede text-foreground">{dictionary.howLede}</p>
		</div>

		<div class="how">
			<ol class="how-steps">
				{
					dictionary.howSteps.map((step, index) => (
						<li class="how-step">
							<span class="how-step-number tabular-nums">{String(index + 1).padStart(2, "0")}</span>
							<span class="text-foreground">{step}</span>
						</li>
					))
				}
			</ol>

			<div class="layers">
				<div class="layer layer-presentation bg-background text-foreground">
					<div class="layer-head">
						<span class="layer-name">{dictionary.howPresentationLabel}</span>
						<span class="layer-owner">{dictionary.howPresentationOwner}</span>
					</div>
					<p class="layer-copy text-foreground">{dictionary.howPresentationCopy}</p>
					<ul class="layer-chips">
						{dictionary.howPresentationItems.map((item) => <li class="layer-chip">{item}</li>)}
					</ul>
				</div>

				<div class="layers-join">
					<span class="layers-join-line" aria-hidden="true"></span>
					<p class="layers-join-label">
						<span class="layers-join-name">{dictionary.howSkillsLabel}</span>
						<span class="text-muted-foreground">{dictionary.howSkillsCopy}</span>
					</p>
					<span class="layers-join-line" aria-hidden="true"></span>
				</div>

				<div class="layer layer-logic bg-stage text-stage-foreground">
					<div class="layer-head">
						<span class="layer-name">{dictionary.howLogicLabel}</span>
						<span class="layer-owner">{dictionary.howLogicOwner}</span>
					</div>
					<p class="layer-copy">{dictionary.howLogicCopy}</p>
					<ul class="layer-chips">
						{dictionary.howLogicItems.map((item) => <li class="layer-chip">{item}</li>)}
					</ul>
				</div>
			</div>
		</div>

		<ul class="section-links">
			<li><a class="section-link" href={GITHUB_SKILLS_URL}>{dictionary.starOnboarding}</a></li>
			<li><a class="section-link" href={DOCS_CLI_PATH}>{dictionary.cliDocsLink}</a></li>
		</ul>
	</div>
</section>
