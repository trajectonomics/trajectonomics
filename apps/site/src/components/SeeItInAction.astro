---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see the icons it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import type { Dictionary } from "../lib/language/dictionary"
import { FI_DEMO_COMMAND, FI_DEMO_OUTPUT } from "../lib/site"
import Check from "./icons/Check.astro"
import Cross from "./icons/Cross.astro"

interface Props {
	readonly dictionary: Dictionary
}

const { dictionary } = Astro.props
---

{/*
 * The comparison now sits inside the hero, so the visitor sees it on landing. It carries no heading of
 * its own: the hero's one h1 is the page's claim, and the panels label themselves Before and After.
 * On a phone the two panels become a tabbed pair; the before panel is what a visitor lands on, and the
 * animation that advances it belongs to another issue (it announces itself with an event).
 */}
<div class="compare-wrap" data-action-compare data-action-stage="without">
	<div class="compare-tabs" role="group" aria-label={dictionary.actionLede}>
		<button
			type="button"
			class="compare-tab-button"
			data-action-tab="without"
			aria-pressed="true"
		>
			{dictionary.actionBeforeLabel}
		</button>
		<button
			type="button"
			class="compare-tab-button"
			data-action-tab="with"
			aria-pressed="false"
		>
			{dictionary.actionAfterLabel}
		</button>
	</div>

	<div class="compare">
		<div class="compare-panel" data-side="without">
			<div class="compare-tab">
				<span class="compare-tab-label">{dictionary.actionBeforeLabel}</span>
				<Cross class="compare-tab-mark" />
			</div>
			<div class="compare-body">
				<p class="compare-question">
					<span class="speaker">{dictionary.actionYou}</span>
					<span class="text-foreground">{dictionary.actionQuestion}</span>
				</p>
				<ol class="compare-runs">
					{
						dictionary.actionGuesses.map((guess, run) => (
							<li class="compare-run">
								<span class="run-label text-muted-foreground">{dictionary.actionRunLabels[run]}</span>
								<span class="bubble bubble-guess">
									<span class="speaker">{dictionary.actionAgent}</span>
									<span class="text-foreground">{guess}</span>
								</span>
							</li>
						))
					}
				</ol>
			</div>
			<p class="compare-note text-muted-foreground">{dictionary.actionWithoutNote}</p>
		</div>

		<div class="compare-panel" data-side="with">
			<div class="compare-tab">
				<span class="compare-tab-label">{dictionary.actionAfterLabel}</span>
				<Check class="compare-tab-mark" />
			</div>
			<div class="compare-body">
				<p class="compare-question">
					<span class="speaker">{dictionary.actionYou}</span>
					<span class="text-foreground">{dictionary.actionQuestion}</span>
				</p>
				<p class="compare-skill-line text-muted-foreground">{dictionary.actionSkillLine}</p>
				<div class="terminal bg-stage text-stage-foreground">
					<code class="terminal-command"><span class="terminal-prompt" aria-hidden="true">$ </span>{FI_DEMO_COMMAND}</code>
					<pre class="terminal-output"><code>{FI_DEMO_OUTPUT.join("\n")}</code></pre>
					<p class="terminal-note">{dictionary.actionExampleNote}</p>
				</div>
				<ol class="compare-runs">
					{
						dictionary.actionRunLabels.map((label) => (
							<li class="compare-run">
								<span class="run-label text-muted-foreground">{label}</span>
								<span class="bubble bubble-answer">
									<span class="speaker">{dictionary.actionAgent}</span>
									<span class="text-foreground">{dictionary.actionAnswer}</span>
								</span>
							</li>
						))
					}
				</ol>
			</div>
			<p class="compare-note text-foreground">{dictionary.actionWithNote}</p>
		</div>
	</div>
</div>

<script is:inline>
	;(() => {
		const wrap = document.querySelector("[data-action-compare]")
		if (!(wrap instanceof HTMLElement)) return
		const tabs = Array.from(wrap.querySelectorAll("[data-action-tab]"))
		if (tabs.length === 0) return

		/** Show one side, and keep the two tab buttons in step with it. */
		const show = (side, announce) => {
			wrap.setAttribute("data-action-stage", side)
			for (const tab of tabs) {
				tab.setAttribute("aria-pressed", String(tab.getAttribute("data-action-tab") === side))
			}
			// Switching tabs is the visitor asking for the animation to run: the animation lives in
			// another issue and listens for this. The auto-advance below passes false so it cannot loop.
			if (announce) {
				window.dispatchEvent(new CustomEvent("traj:action-animation-start", { detail: { side } }))
			}
		}

		for (const tab of tabs) {
			tab.addEventListener("click", () => show(tab.getAttribute("data-action-tab") ?? "without", true))
		}
		// When the animation finishes it announces itself, and the visitor sees the after panel.
		window.addEventListener("traj:action-animation-finished", () => show("with", false))
	})()
</script>
