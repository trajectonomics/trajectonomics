---
// biome-ignore-all lint/correctness/noUnusedImports: Biome cannot read an Astro template, so it cannot see these.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome cannot read an Astro template, so it cannot see these.
import Layout from "../layouts/Layout.astro"
import type { Language } from "../lib/language/language"
import { CLEAN_URL, dictionaryFor } from "../lib/language/languages"

interface Props {
	readonly language: Language
}

const { language } = Astro.props
const dictionary = dictionaryFor(language)
---

<Layout language={language} title={dictionary.notFoundHeading} indexed={false}>
	<div
		class="mx-auto flex max-w-3xl flex-col items-center px-5 pt-32 pb-24 text-center sm:px-6 sm:pt-40 sm:pb-32"
	>
		<h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
			{dictionary.notFoundHeading}
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-pretty text-muted-foreground">
			{dictionary.notFoundBody}
		</p>
		<p class="mt-6 text-lg">
			<a class="text-foreground underline underline-offset-4" href={CLEAN_URL}>
				Trajectonomics
			</a>
		</p>
	</div>
</Layout>
