---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the components and the canonical links it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import "../styles/global.css"
import { FALLBACK_LANGUAGE, type Language } from "../lib/language/language"
import { absoluteLocaleUrl, dictionaryFor, LANGUAGES } from "../lib/language/languages"

interface Props {
	readonly language: Language
	readonly title: string
	readonly indexed: boolean
}

const { language, title, indexed } = Astro.props
const dictionary = dictionaryFor(language)
---

<html lang={language} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/*
			The Theme is on <html> before the first paint: `light` is the no-JavaScript fallback, and this
			inline script switches to `dark` when the device asks for it. It reads no Visitor signal: a
			Locale URL already says which Language the page is ([ADR 0003]).
		*/}
		<script is:inline>
			if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
				document.documentElement.setAttribute("data-theme", "dark")
			}
		</script>
		<title>{title}</title>
		{
			indexed ? (
				<>
					<link rel="canonical" href={absoluteLocaleUrl(language)} />
					{LANGUAGES.map((entry) => (
						<link
							rel="alternate"
							hreflang={entry.language}
							href={absoluteLocaleUrl(entry.language)}
						/>
					))}
					<link rel="alternate" hreflang="x-default" href={absoluteLocaleUrl(FALLBACK_LANGUAGE)} />
				</>
			) : (
				<meta name="robots" content="noindex" />
			)
		}
		<link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
	</head>
	<body class="flex min-h-dvh flex-col bg-background text-foreground">
		<Header language={language} dictionary={dictionary} markCurrent={indexed} />
		<main class="flex flex-1 flex-col bg-muted text-foreground"><slot /></main>
		<Footer dictionary={dictionary} />
	</body>
</html>
