---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the components and the canonical links it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import darkTheme from "@trajectonomics/design-system-theme/themes/dark.css?raw"
import lightTheme from "@trajectonomics/design-system-theme/themes/light.css?raw"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import "../styles/global.css"
import { buildMode } from "../lib/build/mode"
import { fallbackTheme, shippedThemes } from "../lib/design/shipped-themes"
import { themePaints } from "../lib/design/theme-paint"
import { themeScript } from "../lib/design/theme-script"
import { parseDesignTokens } from "../lib/design/tokens"
import type { Language } from "../lib/language/language"
import {
	ABSOLUTE_CLEAN_URL,
	dictionaryFor,
	languageEntry,
	otherLanguages,
} from "../lib/language/languages"
import {
	APPLE_TOUCH_ICON_PATH,
	BING_SITE_VERIFICATION_TOKEN,
	GOOGLE_SITE_VERIFICATION_TOKEN,
	SITE_NAME,
} from "../lib/site"
import { structuredDataJson } from "../lib/site/structured-data"
import { verificationMetas } from "../lib/site/verification"
import { SHARE_IMAGE_HEIGHT, SHARE_IMAGE_WIDTH } from "../lib/social/layout"
import { absoluteShareImageUrl, SHARE_IMAGE_TYPE, shareImageAlt } from "../lib/social/share-advert"

interface Props {
	readonly language: Language
	readonly title: string
	/** The Language home's one-line summary; a miss passes none, so the absence is structural. */
	readonly description?: string
	readonly indexed: boolean
}

const { language, title, description, indexed } = Astro.props
const dictionary = dictionaryFor(language)
// The published Theme CSS the page loads for its own paint, read as text, so the browser's bar and
// the header carry one colour: no colour literal is written here.
const tokens = parseDesignTokens({ themes: [lightTheme, darkTheme], tailwind: "" })
// The Theme is resolved from the Build Mode: a production build ships one Theme and asks for it, so no
// device query decides anything; every other build ships both Themes and follows the device, which is
// what keeps the light Theme capturable while it is deferred ([ADR 0016]).
const mode = buildMode(import.meta.env.MODE)
const themes = shippedThemes(mode)
const paints = themePaints(tokens, themes)
const script = themeScript(themes)
// The owner supplies a search engine's verification token later; no token means no meta at all, and
// a token this repository invented would verify nothing.
const verification = verificationMetas({
	google: GOOGLE_SITE_VERIFICATION_TOKEN,
	bing: BING_SITE_VERIFICATION_TOKEN,
})
---

<html lang={language} data-theme={fallbackTheme(mode)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{script === undefined ? null : <script is:inline set:html={script}></script>}
		<title>{title}</title>
		{paints.map((paint) => (
			<meta name="theme-color" media={paint.media} content={paint.colour} />
		))}
		{
			indexed ? (
				<>
					{description === undefined ? null : <meta name="description" content={description} />}
					<link rel="canonical" href={ABSOLUTE_CLEAN_URL} />
					{/* One address means one alternate: there is no second URL for a Language to name. */}
					<link rel="alternate" hreflang="x-default" href={ABSOLUTE_CLEAN_URL} />
					<meta property="og:title" content={title} />
					{description === undefined ? null : (
						<meta property="og:description" content={description} />
					)}
					<meta property="og:url" content={ABSOLUTE_CLEAN_URL} />
					<meta property="og:type" content="website" />
					<meta property="og:site_name" content={SITE_NAME} />
					{/* The address no longer says which Language a share is in, so the card does. */}
					<meta property="og:locale" content={languageEntry(language).locale} />
					{otherLanguages(language).map((entry) => (
						<meta property="og:locale:alternate" content={entry.locale} />
					))}
					{/* The 1200 × 630 image the prebuild step writes, which every share sheet cuts a large card from. */}
					<meta property="og:image" content={absoluteShareImageUrl(language)} />
					<meta property="og:image:width" content={String(SHARE_IMAGE_WIDTH)} />
					<meta property="og:image:height" content={String(SHARE_IMAGE_HEIGHT)} />
					<meta property="og:image:type" content={SHARE_IMAGE_TYPE} />
					<meta property="og:image:alt" content={shareImageAlt(dictionary)} />
					<meta name="twitter:card" content="summary_large_image" />
					<meta name="twitter:image" content={absoluteShareImageUrl(language)} />
					{verification.map((meta) => (
						<meta name={meta.name} content={meta.content} />
					))}
					{/* Data, not a program: ADR 0005 keeps JSON-LD outside the Program JavaScript budget. */}
					<script type="application/ld+json" set:html={structuredDataJson(language)} />
				</>
			) : (
				<meta name="robots" content="noindex" />
			)
		}
		<link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href={APPLE_TOUCH_ICON_PATH} />
		{/*
			One pageview and the Copy event, posted from the page itself: the Site loads no third-party
			script, so no library arrives with it ([ADR 0005], [ADR 0011]). The script decides for itself
			whether the host and the visitor's opt-out signals allow it.
		*/}
		<script>
			import { startAnalytics } from "../lib/analytics/client"

			startAnalytics()
		</script>
	</head>
	<body class="flex min-h-dvh flex-col bg-background text-foreground">
		<Header language={language} dictionary={dictionary} markCurrent={indexed} />
		<main class="flex flex-1 flex-col bg-muted text-foreground"><slot /></main>
		<Footer dictionary={dictionary} />
		{/*
			The Reveal layer (ADR 0019) and the comparison's own controls (site#95), in one script
			because the page's whole Program JavaScript budget is 10,000 bytes. The page as served is the
			whole story: every message, step, actor and output is in the markup at its resting state, and
			nothing here is needed to read it. The script marks a panel's root so the timeline in the
			stylesheet can play — in the same frame for a root already on screen, so a visitor who lands on it
			never sees a still frame first — and takes the mark and the motion attribute off when the sequence
			ends, so the settled page is the static page again. It sets the stage a phone is on, which is a
			panel at a time; when the before chat has been read it offers the after one with a five-second
			countdown, and the visitor's tap or the countdown's last second moves there. It keeps the newest
			message of a playing panel in view, and it unhides the Replay controls. It sets no stage where
			motion is reduced, so both panels stand whole. The beats are the stylesheet's and the timeline's,
			never counted here. There is no comment inside the script: every byte of it ships, and the whole
			page has 10,000.
		*/}
		<script is:inline>
		;(() => {
			const wrap = document.querySelector("[data-action-compare]")
			const roots = [...document.querySelectorAll(".compare-panel, .how")]
			if (!wrap || matchMedia("(prefers-reduced-motion: reduce)").matches) return
			const panelOf = (side) => roots.find((one) => one.dataset.side === side)
			const cta = wrap.querySelector(".compare-cta")
			const count = wrap.querySelector("[data-action-count]")
			let wait
			const show = (side) => (wrap.dataset.actionStage = side)
			const play = (root) => {
				const d = root.dataset
				if (d.motion) return
				const steps = +d.flowSteps
				delete d.step
				d.motion = "play"
				clearInterval(root.timerId)
				let beat = 0
				root.timerId = setInterval(() => {
					if (steps && ++beat <= steps) return (d.step = beat)
					clearInterval(root.timerId)
					delete d.step
					delete d.motion
					d.side === "without" && offer()
				}, steps ? +d.flowMs : +d.playMs)
			}
			const offer = () => {
				if (!cta.offsetParent) return
				let left = 6
				wrap.dataset.actionCta = "count"
				clearInterval(wait)
				const tick = () => {
					count.textContent = ` (${--left})`
					left || turn("with")
				}
				wait = setInterval(tick, 1e3)
				tick()
			}
			const turn = (side) => {
				clearInterval(wait)
				delete wrap.dataset.actionCta
				show(side)
				play(panelOf(side))
			}
			cta.onclick = () => turn(wrap.dataset.actionStage === "with" ? "without" : "with")
			for (const one of document.querySelectorAll("[data-replay]")) {
				one.hidden = false
				one.onclick = () => (one.dataset.replay ? turn(one.dataset.replay) : play(roots[2]))
			}
			wrap.addEventListener("animationstart", ({ target }) => {
				const message = target.closest(".chat-message")
				const body = message && message.closest(".compare-body")
				if (body)
					body.scrollTop +=
						message.getBoundingClientRect().bottom - body.getBoundingClientRect().bottom
			})
			show("without")
			const watch =
				window.IntersectionObserver &&
				new IntersectionObserver((entries) => {
					for (const { isIntersecting, target } of entries) isIntersecting && play(target)
				})
			for (const root of roots) {
				const { top, bottom } = root.getBoundingClientRect()
				bottom > 0 && top < innerHeight ? play(root) : watch?.observe(root)
			}
		})()
		</script>
	</body>
</html>
