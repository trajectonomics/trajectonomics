{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": true,
	"extends": ["@trajectonomics/tooling/configs/base"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/test-results",
			"!**/playwright-report",
			"!**/*.md",
			"!**/skills-lock.json",
			"!**/.agents",
			"!**/.claude"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
