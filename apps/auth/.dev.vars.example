# Copy to .dev.vars for local work. Never commit .dev.vars. Every value here is a placeholder.
ENVIRONMENT=development
DEV_ONLY=true
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-local-only-secret
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
GITHUB_CLIENT_ID=placeholder-github-client-id
GITHUB_CLIENT_SECRET=placeholder-github-client-secret
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:8787
