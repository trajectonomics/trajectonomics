{
	"name": "@trajectonomics/auth",
	"version": "0.0.0-development",
	"description": "The auth Worker at auth.trajectonomics.com: Better Auth accounts, social sign-in, passkeys, device authorization and Ed25519 JWTs for the platform. Never published to npm.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "wrangler dev",
		"build": "wrangler deploy --dry-run --outdir dist",
		"test": "bun test ./src",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun run test && bun ../../tooling/scripts/build-unless-turbo.ts",
		"schema": "bun run scripts/generate-schema.ts",
		"clients:sql": "bun run scripts/generate-clients.ts",
		"spike": "bun run scripts/spike.ts"
	},
	"dependencies": {
		"@better-auth/oauth-provider": "1.7.28",
		"@better-auth/passkey": "1.7.28",
		"better-auth": "1.7.28"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@cloudflare/workers-types": "5.20261125.1",
		"jose": "6.2.18",
		"@types/bun": "^1.4.4",
		"typescript": "~6.0.3",
		"wrangler": "^4.158.0"
	}
}
