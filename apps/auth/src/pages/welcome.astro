---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import Welcome from "../components/Welcome.svelte"
import Layout from "../layouts/Layout.astro"
import { dictionaryFor } from "../lib/language"

const language = "en"
const words = dictionaryFor(language)
---

<Layout
	language={language}
	page="welcome"
	title={`${words.welcomeTitle} — Trajectonomics`}
	description={words.welcomeDescription}
>
	<Welcome client:load language={language} />
</Layout>
