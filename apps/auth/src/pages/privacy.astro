---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import LegalPage from "../components/LegalPage.astro"
import Layout from "../layouts/Layout.astro"
import { dictionaryFor } from "../lib/language"
import { PRIVACY_EN } from "../lib/legal-privacy-en"

const language = "en"
const words = dictionaryFor(language)
---

<Layout
	language={language}
	page="privacy"
	title={`${words.privacyTitle} — Trajectonomics`}
	description={words.privacyDescription}
	indexed
>
	<LegalPage language={language} title={words.privacyTitle} content={PRIVACY_EN} />
</Layout>
