---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the components it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import darkTheme from "@trajectonomics/brand/current/dark.css?raw"
import lightTheme from "@trajectonomics/brand/current/light.css?raw"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import { dictionaryFor, pagePath } from "../lib/language"
import { themeRole } from "../lib/theme-role"
import { FALLBACK_THEME, themeScript } from "../lib/themes"
import "../styles/global.css"

interface Props {
	readonly language: import("../lib/language").Language
	readonly page: import("../lib/language").Page
	readonly title: string
	readonly description: string
	/** Legal pages are the only ones a search engine may index. */
	readonly indexed?: boolean | undefined
}

const { language, page, title, description, indexed = false } = Astro.props
const words = dictionaryFor(language)
const canonical = new URL(Astro.url.pathname, Astro.site)
const alternates = (["en", "th"] as const).map((code) => ({
	hreflang: code,
	href: new URL(pagePath(code, page), Astro.site).href,
}))
const themeColours = [
	{ scheme: "light", colour: themeRole(lightTheme, "background") },
	{ scheme: "dark", colour: themeRole(darkTheme, "background") },
]
---

<html lang={language} data-theme={FALLBACK_THEME}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline set:html={themeScript()}></script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		{
			alternates.map((alternate) => (
				<link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
		{!indexed && <meta name="robots" content="noindex" />}
		{
			themeColours.map((paint) => (
				<meta
					name="theme-color"
					media={`(prefers-color-scheme: ${paint.scheme})`}
					content={paint.colour}
				/>
			))
		}
		<link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
	</head>
	<body class="auth-body">
		<a class="skip-link" href="#main">{words.skipLink}</a>
		<Header language={language} page={page} />
		<main id="main" class="auth-main"><slot /></main>
		<Footer language={language} />
	</body>
</html>
