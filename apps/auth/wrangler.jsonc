{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	// Better Auth imports node:async_hooks and node:crypto, and the passkey plugin uses Web Crypto.
	"compatibility_flags": ["nodejs_compat"],
	// auth.trajectonomics.com is its own origin on purpose: an XSS on a site sharing this origin
	// could make credentialed requests to the auth endpoints. The first deploy attaches this domain.
	"workers_dev": false,
	"routes": [{ "pattern": "auth.trajectonomics.com", "custom_domain": true }],
	"vars": {
		// Production is the committed default. The dev-only password path also requires a loopback
		// base URL, so setting DEV_ONLY in production cannot enable it.
		"ENVIRONMENT": "production",
		"BETTER_AUTH_URL": "https://auth.trajectonomics.com"
	},
	// The person-facing pages: Astro's static build. Only the auth endpoints, the public key alias
	// and the OAuth discovery documents reach the Worker first (ADR 0003).
	"assets": {
		"directory": "./dist-site",
		"run_worker_first": ["/api/*", "/jwks", "/.well-known/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "traj-auth",
			// Created by the owner on 2026-11-27 in APAC (`wrangler d1 create traj-auth --location apac`).
			"database_id": "6b94f059-3d46-4c6f-85d4-385a8acc3668",
			"migrations_dir": "migrations"
		}
	],
	// Optional at runtime: a deployment without the data service queues every notice and retries it
	// with the hourly cron below. The data Worker's endpoint arrives with #601.
	"services": [{ "binding": "DATA", "service": "data" }],
	"triggers": {
		"crons": ["43 * * * *"]
	}
}
