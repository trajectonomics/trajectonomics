{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	// Better Auth imports node:async_hooks and node:crypto, and the passkey plugin uses Web Crypto.
	"compatibility_flags": ["nodejs_compat"],
	// auth.trajectonomics.com is its own origin on purpose: an XSS on a site sharing this origin
	// could make credentialed requests to the auth endpoints. The owner attaches this route.
	"workers_dev": false,
	"routes": [{ "pattern": "auth.trajectonomics.com", "custom_domain": true }],
	"vars": {
		// Production is the committed default. The dev-only password path also requires a loopback
		// base URL, so setting DEV_ONLY in production cannot enable it.
		"ENVIRONMENT": "production",
		"BETTER_AUTH_URL": "https://auth.trajectonomics.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "traj-auth",
			// PLACEHOLDER: the owner creates the database with `wrangler d1 create traj-auth` and
			// replaces this id. Local `wrangler dev --local` works with the placeholder.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
