# The headers every page carries. Workers static assets read this file; the build replaces the two
# hash placeholders with the `sha256-…` sources of every inline script and style Astro emitted, so no
# script needs `'unsafe-inline'`. The e2e run checks every page and refuses a framed page.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' https: data:; font-src 'self'; connect-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__; style-src 'self' __INLINE_STYLE_HASHES__
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=63072000; includeSubDomains
