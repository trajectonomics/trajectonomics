{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	// The data site lives at trajectonomics.com/data/; the old host keeps its API and ingest and
	// redirects its pages (ADR 0006). The *.workers.dev copy stays off.
	"workers_dev": false,
	"routes": [
		// The zone route takes the data paths from the Site's Custom Domain on the same hostname.
		{ "pattern": "trajectonomics.com/data*", "zone_name": "trajectonomics.com" },
		// The old host stays on this Worker so its API and ingest keep working.
		{ "pattern": "data.trajectonomics.com", "custom_domain": true }
	],
	"assets": {
		// Astro's build: the static overview and method pages, the islands and the brand files.
		"directory": "./dist",
		// The build's root is served at /data/; nothing is emitted at the host root.
		"base_path": "/data",
		// The API, the browser auth routes, ingest and the service-binding endpoint go to the
		// Worker; every other path under /data/ is an asset.
		"run_worker_first": ["/data/api/*", "/data/auth/*", "/data/ingest", "/internal/*"]
	},
	// The issuer of the access tokens ingest trusts (ADR 0015). Not a secret.
	"vars": {
		"AUTH_ISSUER": "https://auth.trajectonomics.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "traj-data",
			"database_id": "84d5685a-42a3-4288-b98f-2cf3ea56a23d",
			"migrations_dir": "migrations"
		}
	],
	// One hourly tick checks freshness. Sending an alert arrives with the auth slice.
	"triggers": {
		"crons": ["17 * * * *"]
	}
}
