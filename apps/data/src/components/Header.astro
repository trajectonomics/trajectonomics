---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.

import SiteHeader from "@trajectonomics/site-header/SiteHeader.astro"
import { DATA_PATH, LOG_PATH, ME_PATH, METHOD_PATH, SITE_HOME_URL, SITE_NAME } from "../lib/site"

interface Props {
	/** Which header link is the current page. */
	readonly current: "overview" | "method" | "log" | "me" | null
}

const { current } = Astro.props
---

<SiteHeader
	homeHref={SITE_HOME_URL}
	homeLabel={`${SITE_NAME} home`}
	marker={{ href: DATA_PATH, label: "Data", current: false }}
	class="data-header"
	navLabel="Main"
>
	<Fragment slot="nav">
		<a
			class="ds-nav-link"
			href={DATA_PATH}
			aria-current={current === "overview" ? "page" : undefined}>Overview</a
		>
		<a
			class="ds-nav-link"
			href={LOG_PATH}
			aria-current={current === "log" ? "page" : undefined}>Log</a
		>
		<a
			class="ds-nav-link"
			href={METHOD_PATH}
			aria-current={current === "method" ? "page" : undefined}>Method</a
		>
	</Fragment>
	<Fragment slot="end">
		<a class="ds-nav-link" href={ME_PATH} aria-current={current === "me" ? "page" : undefined}
			>Your data</a
		>
	</Fragment>
</SiteHeader>
