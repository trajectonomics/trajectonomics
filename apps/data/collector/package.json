{
	"name": "@trajectonomics/data-collector",
	"version": "0.0.0-development",
	"description": "Reads local AI coding tool logs and prints hourly usage totals as JSON lines. Private, never published.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.23.4"
	},
	"exports": {
		"./plans": "./src/plans.ts",
		"./quota-plans": "./src/quota/plans.ts",
		"./price-catalog": "./src/price-catalog.ts",
		"./tier-catalog": "./src/tier-catalog.ts",
		"./types": "./src/types.ts"
	},
	"scripts": {
		"test": "bun test ./test",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/bun": "^1.4.4",
		"typescript": "~6.0.3"
	}
}
