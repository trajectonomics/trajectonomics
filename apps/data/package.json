{
	"name": "@trajectonomics/data",
	"version": "0.0.0-development",
	"description": "The data Worker at data.trajectonomics.com: ingests hourly usage into D1 and serves cached daily rollups. Never published to npm.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "wrangler dev",
		"build": "wrangler deploy --dry-run --outdir dist",
		"test": "bun test ./test",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun run test && bun run build"
	},
	"dependencies": {
		"@trajectonomics/data-collector": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@cloudflare/workers-types": "5.20261125.1",
		"@types/bun": "^1.4.4",
		"typescript": "~6.0.3",
		"wrangler": "^4.158.0"
	}
}
