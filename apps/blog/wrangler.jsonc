{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	// The Site's /blog/ path wins over its apex Custom Domain (Workers > Routes), and the old host
	// stays attached as a Custom Domain so its requests reach the Worker and get the 301 (ADR 0004).
	"routes": [
		{ "pattern": "trajectonomics.com/blog*", "zone_name": "trajectonomics.com" },
		{ "pattern": "blog.trajectonomics.com", "custom_domain": true }
	],
	"assets": {
		// The build stays at ./dist; base_path serves its root under /blog/, and the Worker gets
		// requests outside it (the old host) and misses inside it (the 404 page) (ADR 0004).
		"directory": "./dist",
		"binding": "ASSETS",
		"base_path": "/blog",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
