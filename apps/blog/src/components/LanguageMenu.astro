---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import { dictionaryFor } from "../lib/dictionary"
import { LANGUAGES, type Language } from "../lib/languages"

interface Props {
	/** The Interface Language the page is read in. */
	readonly language: Language
	/** The same page in each Interface Language's tree. */
	readonly languagePaths: Readonly<Record<Language, string>>
}

const { language, languagePaths } = Astro.props
---

<ul class="language-menu" aria-label={dictionaryFor(language).languageMenuLabel}>
	{
		LANGUAGES.map((entry) => (
			<li>
				<a
					class="header-nav-link language-menu-link"
					href={languagePaths[entry]}
					hreflang={entry}
					lang={entry}
					aria-current={entry === language ? "true" : undefined}
				>
					{dictionaryFor(entry).nativeName}
				</a>
			</li>
		))
	}
</ul>
