---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import { dictionaryFor } from "../lib/dictionary"
import { type Language, treePath } from "../lib/languages"
import {
	BLOG_PATH,
	DOCS_URL,
	GITHUB_ORG_URL,
	ISSUES_URL,
	LICENCE_URL,
	SITE_HOME_URL,
	SITE_NAME,
	SOURCE_URL,
} from "../lib/site"

interface Props {
	/** The Interface Language the footer's words are in. */
	readonly language: Language
}

const { language } = Astro.props
const words = dictionaryFor(language)

/** The link columns: a mono label and its links. The page's one `nav` is the header's. */
const columns = [
	{
		label: words.footerRead,
		links: [
			{ text: words.footerBlog, href: treePath(language, BLOG_PATH) },
			{ text: words.footerDocs, href: DOCS_URL },
			{ text: words.footerSiteHome, href: SITE_HOME_URL },
		],
	},
	{
		label: words.footerSource,
		links: [
			{ text: words.footerSourceCode, href: SOURCE_URL },
			{ text: words.footerOrganisation, href: GITHUB_ORG_URL },
		],
	},
	{
		label: words.footerHelp,
		links: [
			{ text: words.footerReport, href: ISSUES_URL },
			{ text: words.footerLicence, href: LICENCE_URL },
		],
	},
] as const
---

<footer class="blog-footer">
	<div class="blog-footer-inner">
		<div class="blog-footer-top">
			<div class="blog-footer-brand">
				<span class="blog-footer-name">{SITE_NAME}</span>
				<span class="blog-footer-tagline">{words.footerTagline}</span>
			</div>
			<div class="blog-footer-columns">
				{
					columns.map((column) => (
						<div>
							<span class="meta-label blog-footer-label">{column.label}</span>
							<ul class="blog-footer-links">
								{column.links.map((link) => (
									<li>
										<a class="blog-footer-link" href={link.href}>
											{link.text}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
		<p class="blog-footer-licence">{words.footerLicenceLine(SITE_NAME)}</p>
	</div>
</footer>
