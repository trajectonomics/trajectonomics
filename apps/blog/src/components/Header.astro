---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.

import LanguageMenu from "@trajectonomics/site-header/LanguageMenu.astro"
import SiteHeader from "@trajectonomics/site-header/SiteHeader.astro"
import { dictionaryFor } from "../lib/dictionary"
import { LANGUAGES, type Language, treePath } from "../lib/languages"
import { BLOG_PATH, SITE_HOME_PATH, SITE_NAME } from "../lib/site"

interface Props {
	/** The Interface Language the header's words are in. */
	readonly language: Language
	/** Where the Language menu takes a reader for each Interface Language. */
	readonly languagePaths: Readonly<Record<Language, string>>
	/** The blog's front page marks its own marker as the current page. */
	readonly current: boolean
}

const { language, languagePaths, current } = Astro.props
const words = dictionaryFor(language)
// The blog's centre stays empty until a second Post Type has posts and type pages exist: a single
// "Guides" link would repeat the marker's own list (docs/design/blog.md).
const choices = LANGUAGES.map((entry) => ({
	href: languagePaths[entry],
	lang: entry,
	hreflang: entry,
	label: dictionaryFor(entry).nativeName,
	current: entry === language,
}))
---

<SiteHeader
	homeHref={SITE_HOME_PATH}
	homeLabel={words.homeLabel(SITE_NAME)}
	marker={{ href: treePath(language, BLOG_PATH), label: words.blogMarker, current }}
	class="blog-header"
	navLabel="Main"
>
	<Fragment slot="end">
		<LanguageMenu
			summaryLabel={words.languageMenuLabel}
			currentLabel={words.languageSwitchLabel}
			choices={choices}
		/>
	</Fragment>
</SiteHeader>
