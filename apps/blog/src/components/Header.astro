---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the imports it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import mark from "@trajectonomics/brand/current/logo/mark.svg?raw"
import { dictionaryFor } from "../lib/dictionary"
import { type Language, treePath } from "../lib/languages"
import { decorativeMark } from "../lib/mark"
import { BLOG_PATH, DOCS_PATH, SITE_HOME_PATH, SITE_NAME } from "../lib/site"
import LanguageMenu from "./LanguageMenu.astro"

interface Props {
	/** The Interface Language the header's words are in. */
	readonly language: Language
	/** Where the Language menu takes a reader for each Interface Language. */
	readonly languagePaths: Readonly<Record<Language, string>>
	/** The blog's front page marks its own link as the current page. */
	readonly current: boolean
}

const { language, languagePaths, current } = Astro.props
const words = dictionaryFor(language)
const artwork = decorativeMark(mark)
---

<header class="blog-header">
	<nav class="blog-header-inner" aria-label="Main">
		<div class="blog-header-brand">
			<a class="brand" href={SITE_HOME_PATH} aria-label={words.homeLabel(SITE_NAME)}>
				<span class="brand-tile"><Fragment set:html={artwork} /></span>
			</a>
			<a class="blog-marker" href={treePath(language, BLOG_PATH)} aria-current={current ? "page" : undefined}>
				{words.blogMarker}
			</a>
		</div>
		<div class="blog-header-end">
			<LanguageMenu language={language} languagePaths={languagePaths} />
			<a class="header-nav-link" href={DOCS_PATH}>{words.docsLink}</a>
		</div>
	</nav>
</header>
