{
	"name": "@trajectonomics/blog",
	"version": "0.0.0-development",
	"description": "The Trajectonomics blog at trajectonomics.com/blog: static Astro served by the Worker blog. Never published to npm.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"predev": "bun scripts/copy-brand-assets.ts && bun scripts/write-redirects.ts",
		"dev": "astro dev",
		"prebuild": "bun scripts/copy-brand-assets.ts && bun scripts/write-redirects.ts",
		"build": "astro build",
		"preview": "bun run build && wrangler dev",
		"test": "bun test ./src ./scripts",
		"typecheck": "astro sync && bun ../../tooling/scripts/run-parallel.ts \"tsc -p tsconfig.json\" \"astro check --noSync\"",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"verify:build": "bun scripts/verify-build.ts",
		"cover": "bun scripts/render-cover.ts",
		"screenshots": "bun run build && bun scripts/screenshots.ts",
		"check": "bun ../../tooling/scripts/run-parallel.ts \"bun run lint\" \"bun run typecheck\" \"bun run test\" && bun run build && bun run verify:build"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "2.6.3",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"astro": "7.4.12",
		"playwright-core": "1.65.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"@trajectonomics/brand": "workspace:*",
		"@trajectonomics/site-header": "workspace:*"
	}
}
