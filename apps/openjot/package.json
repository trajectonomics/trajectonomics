  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node --test \"tests/unit/**/*.test.mjs\" && vite build",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node tests/e2e/month-swipe-width.mjs",
    "test:screenshots": "node tests/screenshots/run.mjs",
    "test:screenshots:update": "node tests/screenshots/run.mjs --update",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "@lucide/svelte": "1.77.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-biometric": "2.5.0",
    "@tauri-apps/plugin-opener": "2.7.3",
    "posthog-js": "1.453.2"
  },
  "devDependencies": {
