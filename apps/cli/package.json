{
	"name": "@trajectonomics/cli",
	"version": "0.0.0",
	"description": "A free, open-source money command line that AI agents operate. Deterministic, local-first, Thai tax first.",
	"keywords": [
		"personal-finance",
		"financial-planning",
		"financial-independence",
		"fire",
		"plaintext-accounting",
		"double-entry",
		"tax",
		"thailand",
		"cli",
		"ai-agents",
		"agent-skills",
		"claude-code"
	],
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"bin": {
		"traj": "./bin/traj.js"
	},
	"files": [
		"bin/"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trajectonomics/trajectonomics.git",
		"directory": "apps/cli"
	},
	"homepage": "https://github.com/trajectonomics/trajectonomics/tree/main/apps/cli#readme",
	"bugs": {
		"url": "https://github.com/trajectonomics/trajectonomics/issues"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"eval": "bun run evals/adr-0002/run.ts",
		"test": "bun test --parallel=4 --no-isolate",
		"typecheck": "tsc --noEmit",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"build": "bun build src/index.ts --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv --outfile dist/traj",
		"check": "bun ../../tooling/scripts/run-parallel.ts \"bun run lint\" \"bun run typecheck\" \"bun run test\" && bun ../../tooling/scripts/build-unless-turbo.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@trajectonomics/core": "workspace:*",
		"@trajectonomics/web": "workspace:*",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2",
		"zod": "^4.6.7"
	}
}
