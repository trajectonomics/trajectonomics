{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["tooling/config/**", "tooling/scripts/**"],
	"globalPassThroughEnv": ["TMPDIR"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": ["BRAND"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"format": {
			"cache": false
		},
		"check": {
			"dependsOn": ["build", "^build", "^check"]
		}
	}
}
