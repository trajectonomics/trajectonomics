{
	"name": "@trajectonomics/brand",
	"version": "0.0.0",
	"private": true,
	"description": "Trajectonomics brand: Design Tokens, Themes, Brand Assets and one folder per white-label brand. Never published.",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.23.4"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./brands/*": "./dist/brands/*",
		"./current/*": "./dist/current/*",
		"./tailwind.css": "./dist/tailwind.css",
		"./typography.css": "./dist/typography.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"generate:tailwind": "bun run scripts/generate-tailwind-theme.ts",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"check": "bun run lint && bun run typecheck && bun run test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@resvg/resvg-wasm": "^2.6.2",
		"@tailwindcss/cli": "^4.3.5",
		"@types/bun": "^1.4.4",
		"tailwindcss": "^4.3.5",
		"tsdown": "^0.23.2",
		"typescript": "^7.0.2"
	}
}
