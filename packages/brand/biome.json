{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": true,
	"extends": ["../../tooling/config/biome/web.json"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/*.md",
			"!**/skills-lock.json",
			"!**/*.svelte",
			"!**/.svelte-kit",
			"!**/.svelte-check",
			"!**/.agents",
			"!**/.claude"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
