---
// biome-ignore-all lint/correctness/noUnusedImports: Biome does not read an Astro template, so it cannot see the stylesheet and the chevron it renders.
// biome-ignore-all lint/correctness/noUnusedVariables: Biome does not read an Astro template, so it cannot see these.
import "./menu.css"

/** One Language the menu offers: the same page in another Interface Language. */
interface Choice {
	readonly href: string
	readonly lang: string
	/** The Language's own name, so a reader finds their own word in a page written another way. */
	readonly label: string
	/** Whether this is the page's Language: `aria-current="page"` marks it. */
	readonly current: boolean
	/** A fuller accessible name, where the visible label is a short code. */
	readonly ariaLabel?: string | undefined
	/** The same address in another Language, for a reader's browser or a search engine. */
	readonly hreflang?: string | undefined
}

interface Props {
	/** The disclosure's accessible name ("Language", "ภาษา"). */
	readonly summaryLabel: string
	/** The short label the summary shows for the reading Language ("EN", "ไทย"). */
	readonly currentLabel: string
	readonly choices: readonly Choice[]
}

const { summaryLabel, currentLabel, choices } = Astro.props
---

<details class="header-menu" data-header-menu>
	<summary class="header-menu-summary ds-nav-link" aria-label={summaryLabel}>
		<span>{currentLabel}</span>
		<svg
			class="header-menu-chevron"
			aria-hidden="true"
			focusable="false"
			viewBox="0 0 16 16"
			width="12"
			height="12"><path
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				d="M4 6.5 8 10.5 12 6.5"></path></svg
		>
	</summary>
	<div class="header-menu-panel">
		{
			choices.map((choice) => (
				<a
					class="header-menu-link"
					href={choice.href}
					lang={choice.lang}
					hreflang={choice.hreflang}
					aria-label={choice.ariaLabel}
					aria-current={choice.current ? "page" : undefined}
				>
					{choice.label}
				</a>
			))
		}
	</div>
</details>

{/*
	The menu's behaviour: native <details> for click and keyboard, with hover as an enhancement on a
	fine pointer. Every byte of an inline script ships against the Site's page budget (ADR 0005): the
	pointer may sit outside a disclosure for CLOSE_DELAY_MS before its menu closes, so a crossing
	between the summary and the panel is not a dismissal; only one menu is open at a time; the
	panel's own 8 px bridge keeps the pointer inside the disclosure across the gap; a click while
	hover holds the menu open never toggles it shut; tabbing out closes it, so no visitor is left
	behind a panel; and a touch screen, which has no pointerleave, is dismissed by an outside tap.
*/}
<script is:inline>
	;(() => {
		const menus = [...document.querySelectorAll("details[data-header-menu]")]
		if (menus.length === 0) return

		const CLOSE_DELAY_MS = 150
		const fine = window.matchMedia("(pointer: fine)").matches

		const closeOthers = (open) => {
			for (const menu of menus) if (menu !== open) menu.open = false
		}

		for (const menu of menus) {
			if (!(menu instanceof HTMLDetailsElement)) continue
			const summary = menu.querySelector("summary")
			let hoverOpened = false
			let closing = null
			const cancelClose = () => {
				if (closing !== null) clearTimeout(closing)
				closing = null
			}

			menu.addEventListener("toggle", () => {
				if (menu.open) closeOthers(menu)
			})

			if (fine) {
				menu.addEventListener("pointerenter", () => {
					cancelClose()
					if (menu.open) return
					hoverOpened = true
					closeOthers(menu)
					menu.open = true
				})
				menu.addEventListener("pointerleave", () => {
					cancelClose()
					closing = setTimeout(() => {
						menu.open = false
						hoverOpened = false
						closing = null
					}, CLOSE_DELAY_MS)
				})
				menu.addEventListener("click", (event) => {
					if (!(event.target instanceof Element)) return
					if (event.target.closest("summary") === null) return
					cancelClose()
					if (!hoverOpened || !menu.open) return
					event.preventDefault()
				})

				menu.addEventListener("focusout", (event) => {
					if (!menu.open) return
					const next = event.relatedTarget
					if (next instanceof Node && menu.contains(next)) return
					menu.open = false
					hoverOpened = false
				})
			}

			menu.addEventListener("keydown", (event) => {
				if (event.key !== "Escape" || !menu.open) return
				menu.open = false
				hoverOpened = false
				if (summary instanceof HTMLElement) summary.focus()
			})

			document.addEventListener("pointerdown", (event) => {
				if (!menu.open) return
				if (event.target instanceof Node && menu.contains(event.target)) return
				menu.open = false
				hoverOpened = false
			})
		}
	})()
</script>
